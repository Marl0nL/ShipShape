#!/bin/sh
# shipshape-setup: ShipShape's installer. Run it on a computer and say what that computer
# should be; it walks through only the steps those roles need, and is safe to run again
# (that is how you update). See docs/runbooks/trust-machines.md, "Set up or update".
#
#   shipshape-setup                    ask which roles (a computer set up before as a Herdr
#                                      client: update it, asking nothing)
#   shipshape-setup --herdr-client [--fleetledger USER@HOST]
#                                      see and manage Ships from Herdr here
#   shipshape-setup --fleetledger-here | --fleetledger-remote | --ship-host
#
# The Herdr client, in order: find FleetLedger's VM (the address given, the one this
# computer used last, else the name its VM is made with, fleetledger.local); pin its host
# key (shown for you to confirm, unless ~/.ssh/known_hosts has it already); ask it, over
# your own ssh, for the setup data (ship-fleet machine-setup); find which trusted machine
# this computer is by its keys, or, when your ssh session there has a shell and this
# computer is not trusted yet, have FleetLedger trust it (shown first, one yes); with no
# such key, ask FleetLedger to pair it by code (while pairing is on there: ship-fleet pair
# on), show the code, this computer's key and FleetLedger's host key, and wait (up to 10
# minutes) for you to approve it on a device that has a shell there; fetch the refresher
# through this machine's own key, with the VM's host key pinned, and install it only when
# its SHA-256 is the one FleetLedger gave; install the Desk and the Fleet panel into
# Herdr, and fill in the Fleet panel's settings.json where you have not; and open the
# Fleet tab. Being on the same network never trusts anything: trust needs a key that
# already has a shell on FleetLedger, or your approval there, typing the code shown here.
#
# Options for the Herdr client (each answers a question, so the whole thing can be run
# with no terminal):
#   --fleetledger DEST          how to reach FleetLedger's VM with ssh: USER@HOST, or a Host
#                               of your ~/.ssh/config
#   --host-key-fingerprint FP   its host key's SHA256: fingerprint, confirmed without asking
#                               (first contact only; --yes never confirms a host key)
#   --name NAME, --scope SCOPE (again for more), --logins agent|owner|both
#                               what FleetLedger trusts this computer as (default: a name
#                               from its host name, all, both)
#   --yes                       trust this computer with what is shown, without asking
#                               (never an approval by code: that is typed on FleetLedger)
#   --no-pairing                with no key that logs in there, do not ask to be paired:
#                               say the one step to take by hand instead
#   --no-open                   do not open the Fleet tab in Herdr
#   --no-herdr                  the refresher only: no Desk, no Fleet panel
#   --no-timer, --no-hc, --lan  passed to the refresher (see docs/runbooks/trust-machines.md)
#
# What it changes here, and nothing else: ~/.ssh/shipshape (the refresher's folder: its key
# when it makes one, the refresher and its settings), the Include line at the top of
# ~/.ssh/config and the timer (both the refresher's install), one line in ~/.ssh/known_hosts
# for FleetLedger's VM when you confirm its key, Herdr's layouts, themes and mods folders
# (the Desk's install script), ~/.local/bin/desk and ~/.local/bin/shipshape-setup, and the
# Fleet panel's settings.json, only the values you have not set. The refresher's hourly
# timer never runs this: a refresh applies data only.

set -u
umask 077
LC_ALL=C
export LC_ALL

D="$HOME/.ssh/shipshape"
CONF="$D/machine.conf"
HERDR_HOME="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
SETTINGS="$HERDR_HOME/mods/fleet/settings.json"
BIN="$HOME/.local/bin"
DEFAULT_DEST=fleetledger@fleetledger.local
MAX_PACKAGE=8388608
TAB='{"name":"Fleet","mod":"fleet"}'
SCHEMA=shipshape.machine-setup/1

stage=
said_fail=

say() { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }
die() {
  warn "shipshape-setup: $*"
  cleanup
  exit 1
}
usage() {
  cleanup
  warn "shipshape-setup: $*"
  warn "Usage: shipshape-setup [--herdr-client] [--fleetledger-here] [--fleetledger-remote] [--ship-host] [--fleetledger DEST] [--host-key-fingerprint FP] [--name NAME] [--scope SCOPE] [--logins agent|owner|both] [--yes] [--no-pairing] [--no-open] [--no-herdr] [--no-timer] [--no-hc] [--lan]"
  exit 2
}
cleanup() {
  # A pairing request still waiting is withdrawn (Ctrl-C, or any stop): nothing is left
  # behind on FleetLedger.
  if [ -n "${pair_token:-}" ]; then
    t=$pair_token pair_token=
    pair_ssh cancel "$t" >/dev/null 2>&1
  fi
  [ -n "$stage" ] && rm -rf "$stage"
  stage=
  # The copy an older installer handed over to (hand_over) goes with it.
  h=${SHIPSHAPE_SETUP_HANDED:-}
  case ${h#"${TMPDIR:-/tmp}"/shipshape-setup.} in
    "$h" | '' | *[!A-Za-z0-9]*) ;;
    *) rm -rf "$h" ;;
  esac
}

# --- checks: every value from FleetLedger or the command line passes one ------------------------
is_name() {
  case $1 in '' | -* | *[!a-z0-9-]*) return 1 ;; esac
  [ "${#1}" -le 31 ]
}
is_host() {
  case $1 in '' | [!A-Za-z0-9]* | *[!A-Za-z0-9.-]*) return 1 ;; esac
  [ "${#1}" -le 253 ]
}
is_user() {
  case $1 in '' | [!a-z_]* | *[!a-z0-9_-]*) return 1 ;; esac
  [ "${#1}" -le 32 ]
}
is_blob() {
  case $1 in AAAAC3NzaC1lZDI1NTE5*) ;; *) return 1 ;; esac
  case $1 in *[!A-Za-z0-9+/=]*) return 1 ;; esac
  [ "${#1}" -le 120 ]
}
is_path() {
  case $1 in /*) ;; *) return 1 ;; esac
  case $1 in *[!A-Za-z0-9._/@+-]* | */../* | */..) return 1 ;; esac
  [ "${#1}" -le 1024 ]
}
is_hex64() {
  case $1 in *[!0-9a-f]*) return 1 ;; esac
  [ "${#1}" -eq 64 ]
}
is_dest() { # USER@HOST, or a Host of ~/.ssh/config (a word of letters, digits, . _ -)
  case $1 in
    *@*) is_user "${1%%@*}" && is_host "${1#*@}" ;;
    '' | -* | *[!A-Za-z0-9._-]*) return 1 ;;
    *) [ "${#1}" -le 253 ] ;;
  esac
}
is_scope() {
  case $1 in
    all) return 0 ;;
    tag:* | ship:*) is_name "${1#*:}" ;;
    *) return 1 ;;
  esac
}

sha256() { { sha256sum 2>/dev/null || shasum -a 256; } <"$1" | cut -c 1-64; }
has() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }

# Answers come from the terminal even when this script arrives on stdin; with none, a
# question is never guessed: it stops and names the option that answers it.
can_ask() { [ "${SHIPSHAPE_SETUP_NO_TTY:-}" != 1 ] && (: </dev/tty) 2>/dev/null; }
ask() { # prompt -> $answer
  printf '%s' "$1" >/dev/tty
  IFS= read -r answer </dev/tty || answer=
}

# --- a flat reading of FleetLedger's JSON --------------------------------------------------------
# One value; objects with keys of a-z, 0-9 and _; strings with no backslash and no control
# character; numbers; true, false, null; at most 6 levels and 1000 items a list. Prints
# PATH<tab>VALUE for each string, number and literal, and PATH<tab>#N for a list of N.
# Anything else is refused (exit 2), so a value can never carry more than it says.
# shellcheck disable=SC2016  # an awk program: its $ are awk's
FLAT_AWK='
function bad(why) { print "! " why; failed = 1; exit 2 }
function ws(   c) { while (p <= n) { c = substr(s, p, 1); if (c == " " || c == "\t" || c == "\n" || c == "\r") p++; else break } }
function str(   q, t) {
  p++
  q = index(substr(s, p), "\"")
  if (q == 0) bad("a string does not end")
  t = substr(s, p, q - 1)
  if (index(t, "\\") || t ~ /[\001-\037]/) bad("a string with an escape")
  p += q
  return t
}
function value(path, depth,   c, t, k, i) {
  if (depth > 6) bad("too deep")
  ws(); c = substr(s, p, 1)
  if (c == "{") {
    p++; ws()
    if (substr(s, p, 1) == "}") { p++; return }
    for (;;) {
      ws(); if (substr(s, p, 1) != "\"") bad("a key is not a string")
      k = str()
      if (k !~ /^[a-z][a-z0-9_]*$/ || length(k) > 40) bad("a key that is not a-z, 0-9 and _")
      t = (path == "" ? k : path "." k)
      if (t in seen) bad("a key given twice")
      seen[t] = 1
      ws(); if (substr(s, p, 1) != ":") bad("not JSON"); p++
      value(t, depth + 1)
      ws(); c = substr(s, p, 1); p++
      if (c == "}") return
      if (c != ",") bad("not JSON")
    }
  }
  if (c == "[") {
    p++; ws(); i = 0
    if (substr(s, p, 1) == "]") { p++; print path "\t#0"; return }
    for (;;) {
      if (i >= 1000) bad("a list that is too long")
      value(path "." i, depth + 1); i++
      ws(); c = substr(s, p, 1); p++
      if (c == "]") { print path "\t#" i; return }
      if (c != ",") bad("not JSON")
    }
  }
  if (c == "\"") { t = str(); print path "\t" t; return }
  if (substr(s, p, 4) == "true") { p += 4; print path "\ttrue"; return }
  if (substr(s, p, 5) == "false") { p += 5; print path "\tfalse"; return }
  if (substr(s, p, 4) == "null") { p += 4; print path "\tnull"; return }
  t = ""
  while (p <= n && index("-0123456789", substr(s, p, 1)) > 0) { t = t substr(s, p, 1); p++ }
  if (t !~ /^-?(0|[1-9][0-9]*)$/) bad("not JSON")
  print path "\t" t
}
{ s = s $0 "\n" }
END {
  if (failed) exit 2
  n = length(s); p = 1; ws()
  if (substr(s, p, 1) != "{") bad("not a JSON object")
  value("", 0); ws()
  if (p <= n) bad("something after the document")
}
'
flat() { awk "$FLAT_AWK" <"$1"; }
field() { # flat-file path -> its value (the first)
  awk -F '\t' -v k="$2" '$1 == k { print $2; exit }' "$1"
}

# --- finding FleetLedger, and its host key ---------------------------------------------------------
remembered_dest() {
  if [ -f "$SETTINGS" ]; then
    v=$(sed -n 's/^[[:space:]]*"ssh"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' "$SETTINGS" | head -n 1)
    if is_dest "$v"; then printf '%s' "$v"; return; fi
  fi
  if [ -f "$CONF" ]; then
    u=$(sed -n 's/^user=//p' "$CONF" | head -n 1)
    h=$(sed -n 's/^hosts=//p' "$CONF" | head -n 1)
    h=${h%% *}
    if is_user "$u" && is_host "$h"; then printf '%s@%s' "$u" "$h"; fi
  fi
}

# ssh as you use it (your ~/.ssh/config, agent and keys), never asking anything: what the
# Fleet panel runs too. Host keys are checked against ~/.ssh/known_hosts.
your_ssh() {
  ssh -T -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=15 "$@" </dev/null
}

# FleetLedger's host key, pinned on first contact: known already (ssh checks it on every
# connection), the one this computer's refresher pinned, or shown and confirmed. Returns 1,
# saying why in $unreachable, when FleetLedger cannot be reached and this computer was set
# up before (its refresher and the Desk can still be brought up to date).
pin_host_key() {
  conf=$(ssh -G "$DEST" 2>/dev/null) || die "ssh cannot read its settings for $DEST."
  hn=$(printf '%s\n' "$conf" | awk '$1 == "hostname" { print $2; exit }')
  port=$(printf '%s\n' "$conf" | awk '$1 == "port" { print $2; exit }')
  alias=$(printf '%s\n' "$conf" | awk '$1 == "hostkeyalias" { print $2; exit }')
  is_host "$hn" || die "ssh's host name for $DEST is not one this installer takes: $hn"
  case $port in '' | *[!0-9]*) port=22 ;; esac
  if [ -n "$alias" ]; then kh_name=$alias
  elif [ "$port" = 22 ]; then kh_name=$hn
  else kh_name="[$hn]:$port"; fi
  known_hosts="$HOME/.ssh/known_hosts"
  # Known under any key type (or a CA line): ssh decides on every connection, and this never
  # calls it a first contact, whatever a scan would say.
  known_any=$(ssh-keygen -F "$kh_name" -f "$known_hosts" 2>/dev/null | grep -v '^#')
  host_blobs=$(printf '%s\n' "$known_any" | awk '$2 == "ssh-ed25519" { print $3 }' | tr '\n' ' ')
  [ -n "$known_any" ] && return 0
  scanned=$(ssh-keyscan -T 10 -t ed25519 -p "$port" "$hn" 2>/dev/null | awk '$2 == "ssh-ed25519" { print $3; exit }')
  if [ -z "$scanned" ]; then
    unreachable="Could not reach FleetLedger at $DEST ($hn, port $port). Is this computer on the same network (your LAN or tailnet) as FleetLedger's VM? Name it with --fleetledger USER@HOST."
    [ -f "$CONF" ] && return 1
    die "$unreachable"
  fi
  is_blob "$scanned" || die "$hn answered with a host key this installer does not take."
  host_blobs=$scanned
  pinned=$(conf_value host_key)
  if [ -n "$pinned" ] && [ "${pinned#ssh-ed25519 }" = "$scanned" ]; then
    say "$hn's host key is the one this computer's refresher pinned."
  else
    printf 'ssh-ed25519 %s\n' "$scanned" >"$stage/scanned.pub"
    fp=$(ssh-keygen -l -f "$stage/scanned.pub" 2>/dev/null | awk '{ print $2 }')
    [ -n "$fp" ] || die "Cannot read $hn's host key."
    say "First contact with $hn: its host key is ED25519 $fp."
    if [ -n "$want_fp" ]; then
      [ "$want_fp" = "$fp" ] || die "That is not the fingerprint you gave ($want_fp): not trusting $hn."
    elif can_ask; then
      say "Check it against FleetLedger's VM (there: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub)."
      ask "Is this FleetLedger's VM? [y/N] "
      case $answer in y | Y | yes | YES) ;; *) die "Not trusted; nothing was changed." ;; esac
    else
      die "First contact with $hn: confirm its host key with --host-key-fingerprint $fp (after checking it on the VM: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub)."
    fi
  fi
  { mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"; } || die "Cannot make ~/.ssh."
  printf '%s ssh-ed25519 %s\n' "$kh_name" "$scanned" >>"$known_hosts" || die "Cannot write ~/.ssh/known_hosts."
  say "Added $hn's host key to ~/.ssh/known_hosts."
}

# ship-fleet machine-setup --json over your own ssh. Sets shell=yes when your session there
# has a shell, and which key it logged in with (ssh -v's "Server accepts key").
fetch_setup() {
  rm -f "$stage/setup.json" "$stage/setup.err"
  your_ssh -v "$DEST" ship-fleet machine-setup --json >"$stage/setup.json" 2>"$stage/setup.err"
  rc=$?
  shell=no
  # What ssh -v says of itself (its debug lines, its banner, its closing figures) is left
  # out: what is left is FleetLedger's words, or ssh's reason for failing.
  grep -v -e '^debug' -e '^OpenSSH_' -e '^Authenticated to ' -e '^Transferred: ' \
    -e '^Bytes per second' -e '^[[:space:]]*$' "$stage/setup.err" >"$stage/setup.said"
  last=$(tail -n 1 "$stage/setup.said" | tr -cd ' -~' | cut -c 1-300)
  first=$(head -n 1 "$stage/setup.said" | tr -cd ' -~' | cut -c 1-300)
  if [ "$rc" -eq 0 ] && grep -q '"schema": *"shipshape.machine-bundle/1"' "$stage/setup.json"; then
    access_said="the key ssh used for $DEST may only fetch this machine's bundle there"
    return 0
  fi
  case $rc in
    0) ;;
    255)
      case $last in
        *"ermission denied"*) access_said="no key here logs in to $DEST"; return 0 ;;
        *"ost key verification failed"*) die "ssh refused the host key of $DEST: it is not the one ~/.ssh/known_hosts has for it, so this is not trusting it. If FleetLedger's VM really was remade, remove the old line (ssh-keygen -R '$kh_name') and run this again." ;;
        *) die "Could not reach FleetLedger at $DEST: ${last:-ssh gave no reason}. Is this computer on the same network (your LAN or tailnet) as FleetLedger's VM?" ;;
      esac ;;
    *)
      if grep -q "invalid choice" "$stage/setup.said"; then
        die "FleetLedger at $DEST is older than this installer: update it there first (ship-fleet self-update), then run this again."
      fi
      die "FleetLedger at $DEST refused: ${first:-it gave no reason}" ;;
  esac
  flat "$stage/setup.json" >"$stage/setup.flat" \
    || die "FleetLedger's setup data is not a document this installer takes ($(sed -n 's/^! //p' "$stage/setup.flat" | head -n 1))."
  shell=yes
  accepted=$(sed -n 's/^debug1: Server accepts key: //p' "$stage/setup.err" | head -n 1)
  read_setup
}

read_setup() {
  f=$stage/setup.flat
  [ "$(field "$f" schema)" = "$SCHEMA" ] || die "FleetLedger's setup data is not version 1 of $SCHEMA: update this installer (it updates itself from a FleetLedger that has a shell for you) or FleetLedger."
  fl_user=$(field "$f" fleetledger.user)
  is_user "$fl_user" || die "FleetLedger's user name is out of place."
  n=$(field "$f" fleetledger.hosts)
  n=${n#\#}
  case $n in '' | *[!0-9]*) die "FleetLedger's host names are out of place." ;; esac
  { [ "$n" -ge 1 ] && [ "$n" -le 8 ]; } || die "FleetLedger names 1 to 8 host names."
  fl_hosts='' i=0
  while [ "$i" -lt "$n" ]; do
    h=$(field "$f" "fleetledger.hosts.$i")
    is_host "$h" || die "One of FleetLedger's host names is out of place."
    fl_hosts="${fl_hosts:+$fl_hosts }$h"
    i=$((i + 1))
  done
  hk=$(field "$f" fleetledger.host_key)
  case $hk in "ssh-ed25519 "*) ;; *) die "FleetLedger's host key is out of place." ;; esac
  fl_blob=${hk#ssh-ed25519 }
  is_blob "$fl_blob" || die "FleetLedger's host key is out of place."
  # Known as ed25519: it must be the key FleetLedger records for itself. Known only as
  # another type, ssh checked that one, and the refresher's own fetch pins this one.
  [ -z "$host_blobs" ] || has "$fl_blob" "$host_blobs" || die "$DEST is not the VM FleetLedger records as its own (its host key differs): not going on."
  refresher_sha=$(field "$f" refresher_sha256)
  is_hex64 "$refresher_sha" || die "FleetLedger's refresher digest is out of place."
  package_sha=$(field "$f" package.sha256)
  is_hex64 "$package_sha" || die "FleetLedger's package digest is out of place."
  package_bytes=$(field "$f" package.bytes)
  case $package_bytes in '' | *[!0-9]*) die "FleetLedger's package size is out of place." ;; esac
  [ "$package_bytes" -le "$MAX_PACKAGE" ] || die "FleetLedger's package is over 8 MiB."
  n=$(field "$f" machines)
  n=${n#\#}
  case $n in '' | *[!0-9]*) die "FleetLedger's trusted machines are out of place." ;; esac
  : >"$stage/machines"
  i=0
  while [ "$i" -lt "$n" ]; do
    mn=$(field "$f" "machines.$i.name")
    mk=$(field "$f" "machines.$i.key")
    ma=$(field "$f" "machines.$i.access")
    is_name "$mn" || die "A trusted machine's name is out of place."
    case $mk in "ssh-ed25519 "*) is_blob "${mk#ssh-ed25519 }" || die "A trusted machine's key is out of place." ;; *) die "A trusted machine's key is out of place." ;; esac
    case $ma in bundle | shell | none) ;; *) die "A trusted machine's access is out of place." ;; esac
    printf '%s %s %s\n' "$mn" "${mk#ssh-ed25519 }" "$ma" >>"$stage/machines"
    i=$((i + 1))
  done
}

# --- which machine this computer is ----------------------------------------------------------------
# Its keys: each ed25519 .pub file under ~/.ssh (and one folder down) with its private half
# beside it. A key FleetLedger trusts names the machine; nothing else does.
local_keys() {
  for p in "$HOME"/.ssh/*.pub "$HOME"/.ssh/*/*.pub; do
    [ -f "$p" ] || continue
    case $p in *-cert.pub) continue ;; esac
    [ -f "${p%.pub}" ] || continue
    is_path "${p%.pub}" || continue
    t='' b=''
    read -r t b _ <"$p" 2>/dev/null
    [ "$t" = ssh-ed25519 ] && is_blob "$b" && printf '%s %s\n' "$b" "${p%.pub}"
  done
}

identify() {
  me='' me_key='' found='' conf_found=''
  conf_name=$(sed -n 's/^name=//p' "$CONF" 2>/dev/null | head -n 1)
  local_keys >"$stage/keys"
  while read -r mn mb ma; do
    k=$(awk -v b="$mb" '$1 == b { print $2; exit }' "$stage/keys")
    [ -n "$k" ] || continue
    found="${found:+$found }$mn"
    if [ -n "$want_name" ] && [ "$mn" != "$want_name" ]; then continue; fi
    [ "$mn" = "$conf_name" ] && conf_found=1
    if [ -z "$me" ] || [ "$mn" = "$conf_name" ]; then me=$mn me_key=$k; fi
  done <"$stage/machines"
  # More than one, and neither --name nor machine.conf names one of them: never a guess.
  if [ -z "$want_name" ] && [ -z "$conf_found" ] && [ "$(printf '%s' "$found" | wc -w)" -gt 1 ]; then
    die "This computer holds the keys of more than one trusted machine ($found): say which it is with --name NAME."
  fi
  if [ -n "$want_name" ] && [ -z "$me" ] && grep -q "^$want_name " "$stage/machines"; then
    die "$want_name is trusted with a key this computer does not have (under ~/.ssh)."
  fi
}

suggest_name() {
  h=$(hostname 2>/dev/null || uname -n)
  h=$(printf '%s' "${h%%.*}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | sed 's/^-*//; s/-*$//' | cut -c 1-31)
  is_name "$h" || h=this-computer
  printf '%s' "$h"
}

# This computer's own key for the refresher: no passphrase, so its timer can use it; on the
# VM it may fetch this machine's bundle and nothing else.
own_key() {
  key_path="$D/id_ed25519"
  if [ ! -f "$key_path" ]; then
    { mkdir -p "$D" && chmod 700 "$HOME/.ssh" "$D"; } || die "Cannot make $D."
    ssh-keygen -q -t ed25519 -N '' -C "shipshape-$(suggest_name)" -f "$key_path" </dev/null >/dev/null \
      || die "ssh-keygen could not make $key_path."
    say "Made this computer's key for ShipShape: $key_path (no passphrase, so its timer can use it)."
  fi
  [ -f "$key_path.pub" ] || die "$key_path has no .pub file beside it."
  # The public half from the private key itself: a .pub file beside another key is never
  # what gets trusted.
  derived=$(ssh-keygen -y -f "$key_path" </dev/null 2>/dev/null)
  t=${derived%% *} key_blob=${derived#* }
  key_blob=${key_blob%% *}
  if [ "$t" != ssh-ed25519 ] || ! is_blob "$key_blob"; then die "$key_path is not an ed25519 key this installer can read (one with no passphrase)."; fi
  t='' b=''
  read -r t b _ <"$key_path.pub"
  [ "$b" = "$key_blob" ] || die "$key_path.pub is not the public half of $key_path: fix or remove it, then run this again."
}

trust_here() {
  own_key
  name=${want_name:-$(suggest_name)}
  is_name "$name" || die "Not a machine name: $name"
  if grep -q "^$name " "$stage/machines"; then
    die "FleetLedger already trusts a machine called $name, with another key: give this computer a name of its own with --name NAME."
  fi
  scope_args='' scope_said=''
  for s in ${want_scope:-all}; do
    scope_args="$scope_args --scope $s"
    scope_said="${scope_said:+$scope_said, }$s"
  done
  logins=${want_logins:-both}
  say "This computer is not trusted by FleetLedger yet, and your ssh session there has a shell, so it can trust it now:"
  say "  as $name, for $scope_said, to log in to Ships as $(logins_said "$logins"), with the key $key_path.pub."
  say "  On FleetLedger it runs: ship-fleet trust $name --key 'ssh-ed25519 $key_blob'$scope_args --logins $logins"
  if [ "$yes" != 1 ]; then
    if can_ask; then
      ask "Trust this computer? [y/N] "
      case $answer in y | Y | yes | YES) ;; *) die "Not trusted; nothing was changed. (Other choices: --name NAME, --scope SCOPE, --logins agent|owner|both.)" ;; esac
    else
      die "Not trusted: add --yes to trust this computer as shown (or choose with --name, --scope, --logins)."
    fi
  fi
  # shellcheck disable=SC2086  # each scope a word, each checked
  your_ssh "$DEST" ship-fleet trust "$name" --key "'ssh-ed25519 $key_blob'" $scope_args --logins "$logins" \
    >"$stage/trust.out" 2>"$stage/trust.err"
  rc=$?
  grep -v "^sh -c '" "$stage/trust.out" | grep -v '^On .*paste this one line' | sed 's/^/  /'
  if [ "$rc" -ne 0 ]; then
    sed 's/^/  /' "$stage/trust.err" >&2
    die "FleetLedger did not trust this computer (above); nothing else was changed here."
  fi
  say "FleetLedger trusts this computer as $name."
}

logins_said() {
  case $1 in agent) echo "agent" ;; owner) echo "you (owner)" ;; *) echo "agent and you (owner)" ;; esac
}

# --- pairing by code: a computer with no credential that has a shell on FleetLedger ---------------
# This computer asks FleetLedger to trust its own key; you approve it there, on a device that
# has a shell, by typing the code shown here (ship-fleet pair approve, or the Fleet panel's
# Machines page). It reaches FleetLedger through the well-known pairing key below, which is
# public by design (anyone may read it here): on FleetLedger its one line, there only while
# pairing is on, runs `ship-fleet machine-pair` and nothing else, which can only file a
# request and say how it stands (contracts/machine-pair.schema.json). Nothing it answers is
# trusted before FleetLedger's host key is (pin_host_key), and only an approval names this
# computer's key, its name and the refresher to run: it then ends as a trusted run does.
PAIR_KEY_BODY='b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
QyNTUxOQAAACBzN8Do5bgFclIM+lzimWhIBPLntZwsHipZMXqPMmcgpwAAAJjpORa/6TkW
vwAAAAtzc2gtZWQyNTUxOQAAACBzN8Do5bgFclIM+lzimWhIBPLntZwsHipZMXqPMmcgpw
AAAECWBw8X1CEX5XIWuLAACM1t37HhSKBuwDpDxP9V8J67PHM3wOjluAVyUgz6XOKZaEgE
8ue1nCweKlkxeo8yZyCnAAAAEXNoaXBzaGFwZS1wYWlyaW5nAQIDBA=='
PAIR_SCHEMA=shipshape.machine-pair/1
PAIR_WAIT=${SHIPSHAPE_SETUP_PAIR_WAIT:-3}
case $PAIR_WAIT in '' | *[!0-9]* | 0) PAIR_WAIT=3 ;; esac
pair_token=''

# ssh to FleetLedger with the pairing key alone: ssh's own settings ignored (-F none), the host
# key checked against ~/.ssh/known_hosts as pin_host_key left it, nothing forwarded.
pair_ssh() {
  [ -f "$stage/pairing" ] || return 255
  ssh -F none -T -x -a -i "$stage/pairing" -l "$pair_user" -p "$port" -o BatchMode=yes \
    -o IdentitiesOnly=yes -o IdentityAgent=none -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile="$HOME/.ssh/known_hosts" -o GlobalKnownHostsFile=/dev/null \
    -o HostKeyAlias="$kh_name" -o ConnectTimeout=15 -o ClearAllForwardings=yes \
    -o PermitLocalCommand=no -o ControlMaster=no -o ControlPath=none -o ProxyCommand=none \
    -o LogLevel=ERROR -- "$hn" "$*" </dev/null 2>"$stage/pair.err" | head -c 4097
}

# The code for FleetLedger's nonce and this computer's key, worked out here
# (pairing.code_for): the first 8 hex digits of a SHA-256, as a number, modulo 1000000.
pair_code() {
  printf 'shipshape-pair/1:%s:%s' "$1" "$2" >"$stage/pair.code-in"
  h=$(sha256 "$stage/pair.code-in" | cut -c 1-8)
  printf '%06d' $((0x$h % 1000000))
}

# One answer, read flat into $stage/pair.flat; its state in $pair_state ('' when it is not one).
pair_ask() {
  pair_state=''
  pair_ssh "$@" >"$stage/pair.json"
  flat "$stage/pair.json" >"$stage/pair.flat" 2>/dev/null || return 0
  [ "$(field "$stage/pair.flat" schema)" = "$PAIR_SCHEMA" ] || return 0
  pair_state=$(field "$stage/pair.flat" state)
  case $pair_state in pending | approved | refused | unknown | busy | off) ;; *) pair_state='' ;; esac
}

# Returns 0 with this computer approved (me, me_key, fl_user, fl_hosts, fl_blob and
# refresher_sha set, as read_setup sets them); 1, saying why in $pair_why, when pairing is
# not to be had (then the step by hand is said); dies when you refused it or it lapsed.
pair_here() {
  pair_why=''
  # How ssh reaches FleetLedger: its user as you name it (or ssh's), hn and port as pinned.
  pair_user=${DEST%@*}
  [ "$pair_user" = "$DEST" ] && pair_user=$(ssh -G "$DEST" 2>/dev/null | awk '$1 == "user" { print $2; exit }')
  is_user "$pair_user" || { pair_why="ssh's user for $DEST is not one this installer takes"; return 1; }
  { printf -- '-----BEGIN OPENSSH %s-----\n' 'PRIVATE KEY'
    printf '%s\n' "$PAIR_KEY_BODY"
    printf -- '-----END OPENSSH %s-----\n' 'PRIVATE KEY'; } >"$stage/pairing"
  chmod 600 "$stage/pairing"
  pair_ask request "$key_blob" "$name"
  case $pair_state in
    pending) ;;
    busy) pair_why="FleetLedger has as many pairing requests waiting as it takes just now (try again in a few minutes)"; return 1 ;;
    off) pair_why="pairing by code is off on FleetLedger (there: ship-fleet pair on, or the Fleet panel's Machines > Turn pairing on)"; return 1 ;;
    '')
      last=$(tail -n 1 "$stage/pair.err" 2>/dev/null | tr -cd ' -~' | cut -c 1-200)
      case $last in
        *"ermission denied"*) pair_why="FleetLedger takes no pairing request (pairing by code is off there, or that FleetLedger is older than it: there, ship-fleet self-update, then ship-fleet pair on)" ;;
        *) pair_why="FleetLedger did not answer the pairing request (${last:-no reason given})" ;;
      esac
      return 1 ;;
    *) pair_why="FleetLedger refused the pairing request: $(field "$stage/pair.flat" why | tr -cd ' -~' | cut -c 1-200)"; return 1 ;;
  esac
  f=$stage/pair.flat
  pid=$(field "$f" id) token=$(field "$f" token) nonce=$(field "$f" nonce)
  code=$(field "$f" code) left=$(field "$f" expires_in)
  case $pid in p[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; *) die "FleetLedger's pairing answer is out of place." ;; esac
  case $token$nonce in *[!0-9a-f]*) die "FleetLedger's pairing answer is out of place." ;; esac
  { [ "${#token}" -eq 32 ] && [ "${#nonce}" -eq 32 ]; } || die "FleetLedger's pairing answer is out of place."
  case $left in '' | *[!0-9]*) die "FleetLedger's pairing answer is out of place." ;; esac
  [ "$left" -ge 1 ] && [ "$left" -le 900 ] || die "FleetLedger's pairing answer is out of place."
  pair_token=$token
  # The code is this computer's own work, from its key: one that differs is not this request.
  mine=$(pair_code "$nonce" "$key_blob")
  [ "$mine" = "$code" ] || die "FleetLedger's code for this request is not the one this computer's key gives: not going on."
  printf 'ssh-ed25519 %s\n' "$key_blob" >"$stage/me.pub"
  my_fp=$(ssh-keygen -l -f "$stage/me.pub" 2>/dev/null | awk '{ print $2 }')
  fl_fp=''
  for b in $host_blobs; do
    printf 'ssh-ed25519 %s\n' "$b" >"$stage/fl.pub"
    fl_fp=$(ssh-keygen -l -f "$stage/fl.pub" 2>/dev/null | awk '{ print $2 }')
    break
  done
  say "This computer is not trusted by FleetLedger yet, and no key here has a shell there, so it asked to be paired by code (request $pid)."
  say ""
  say "  Code:                   ${mine%???} ${mine#???}"
  say "  This computer's key:    ED25519 $my_fp ($key_path.pub)"
  [ -n "$fl_fp" ] && say "  FleetLedger's host key: ED25519 $fl_fp (pinned here)"
  say ""
  say "Approve it on a device that has a shell on FleetLedger: the Fleet panel's Machines page > Approve, or in a terminal:"
  say "  ssh $DEST ship-fleet pair approve $pid"
  say "and type the code above there. It shows this computer's key and its own host key: check they are the ones above."
  say "Waiting for it (up to $((left / 60)) minutes; Ctrl-C withdraws the request)..."
  now=$(date +%s)
  deadline=$((now + left + 5))
  while :; do
    sleep "$PAIR_WAIT"
    pair_ask status "$token"
    case $pair_state in
      approved) break ;;
      pending) ;;
      refused) pair_token=''; die "FleetLedger refused this computer's pairing request; nothing was changed there. (Here: only this computer's key, $key_path.)" ;;
      unknown) pair_token=''; die "This computer's pairing request lapsed or was withdrawn before it was approved; nothing was changed on FleetLedger. Run this again to ask again." ;;
      off) pair_token=''; die "Pairing by code was turned off on FleetLedger before this computer was approved; nothing was changed there." ;;
      *) ;; # a moment's trouble reaching it: ask again until the request would lapse
    esac
    if [ "$(date +%s)" -ge "$deadline" ]; then
      pair_token=''
      die "This computer's pairing request lapsed before it was approved (after $((left / 60)) minutes); nothing was changed on FleetLedger. Run this again to ask again."
    fi
  done
  pair_token=''
  f=$stage/pair.flat
  me=$(field "$f" machine)
  is_name "$me" || die "FleetLedger's approval names no machine this installer takes."
  me_key=$key_path
  # As read_setup reads machine-setup's: each value checked, and the host key the one pinned.
  fl_user=$(field "$f" fleetledger.user)
  is_user "$fl_user" || die "FleetLedger's user name is out of place."
  n=$(field "$f" fleetledger.hosts)
  n=${n#\#}
  case $n in '' | *[!0-9]*) die "FleetLedger's host names are out of place." ;; esac
  { [ "$n" -ge 1 ] && [ "$n" -le 8 ]; } || die "FleetLedger names 1 to 8 host names."
  fl_hosts='' i=0
  while [ "$i" -lt "$n" ]; do
    h=$(field "$f" "fleetledger.hosts.$i")
    is_host "$h" || die "One of FleetLedger's host names is out of place."
    fl_hosts="${fl_hosts:+$fl_hosts }$h"
    i=$((i + 1))
  done
  hk=$(field "$f" fleetledger.host_key)
  case $hk in "ssh-ed25519 "*) ;; *) die "FleetLedger's host key is out of place." ;; esac
  fl_blob=${hk#ssh-ed25519 }
  is_blob "$fl_blob" || die "FleetLedger's host key is out of place."
  [ -z "$host_blobs" ] || has "$fl_blob" "$host_blobs" || die "$DEST is not the VM FleetLedger records as its own (its host key differs): not going on."
  refresher_sha=$(field "$f" refresher_sha256)
  is_hex64 "$refresher_sha" || die "FleetLedger's refresher digest is out of place."
  say "FleetLedger approved this computer as $me."
  return 0
}

# A computer with no credential that has a shell on FleetLedger: paired by code (above), or,
# with pairing not to be had, the one step to take by hand on a computer that has one.
no_credentials() {
  own_key
  name=${want_name:-$(suggest_name)}
  if [ "$no_pairing" != 1 ]; then
    if pair_here; then return 0; fi
    warn "Could not ask to be paired by code: $pair_why."
    warn ""
  fi
  warn "This computer cannot trust itself on FleetLedger: $access_said, and only a key that already has a shell there may trust a new one."
  warn ""
  warn "One step, on a computer whose key does (your main machine): in Herdr's Fleet tab, Machines > Trust a machine, with the name $name and this key:"
  warn "  ssh-ed25519 $key_blob"
  warn "or, there, in a terminal:"
  warn "  ssh $DEST ship-fleet trust $name --key 'ssh-ed25519 $key_blob' --scope all --logins both"
  warn ""
  warn "Then, here: paste the one line it prints (it installs this computer's refresher), and run shipshape-setup --herdr-client again for the Desk and the Fleet panel."
  cleanup
  exit 1
}

# --- the refresher -------------------------------------------------------------------------------
# Fetched as the pasted line fetches it: with this machine's own key, ssh's own settings
# ignored, FleetLedger's host key pinned from its setup data; run only when its SHA-256 is
# the one that data names.
fetch_refresher() {
  pin="$stage/pin"
  printf '%s ssh-ed25519 %s\n' "$(printf '%s' "$fl_hosts" | tr ' ' ',')" "$fl_blob" >"$pin"
  why=''
  for h in $fl_hosts; do
    if ssh -F none -T -x -a -i "$me_key" -l "$fl_user" -o BatchMode=yes -o IdentitiesOnly=yes \
      -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$pin" -o GlobalKnownHostsFile=/dev/null \
      -o HostKeyAlgorithms=ssh-ed25519 -o ConnectTimeout=15 -o ClearAllForwardings=yes \
      -o PermitLocalCommand=no -o ControlMaster=no -o ControlPath=none -o ProxyCommand=none \
      -o LogLevel=ERROR -- "$h" ship-fleet machine-bundle "$me" </dev/null \
      2>"$stage/bundle.err" | head -c 4194305 >"$stage/bundle.json"; then
      [ -s "$stage/bundle.json" ] && break
    fi
    why="${why:+$why; }$h: $(tail -n 1 "$stage/bundle.err" 2>/dev/null | tr -cd ' -~' | cut -c 1-200)"
    : >"$stage/bundle.json"
  done
  [ -s "$stage/bundle.json" ] || die "Could not fetch $me's bundle with its key $me_key ($why)."
  grep '^  "refresher": "' "$stage/bundle.json" | cut -d: -f2 | tr -dc 'A-Za-z0-9+/=' \
    | base64 --decode >"$stage/refresh" 2>/dev/null
  [ -s "$stage/refresh" ] || die "FleetLedger sent no refresher in $me's bundle."
  [ "$(sha256 "$stage/refresh")" = "$refresher_sha" ] \
    || die "The refresher FleetLedger sent is not the one its setup data names: not installed."
}

conf_value() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | head -n 1; }

timer_present() {
  [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/shipshape-refresh.timer" ] \
    || [ -f "$HOME/Library/LaunchAgents/local.shipshape.refresh.plist" ]
}

install_refresher() {
  fetch_refresher
  if [ -z "$refresher_opts" ] && [ -f "$D/refresh" ] && [ "$(sha256 "$D/refresh")" = "$refresher_sha" ] \
    && [ "$(conf_value name)" = "$me" ] && [ "$(conf_value key)" = "$me_key" ] \
    && [ "$(conf_value hosts)" = "$fl_hosts" ] && [ "$(conf_value host_key)" = "ssh-ed25519 $fl_blob" ]; then
    say "The refresher here is current; refreshing."
    if "$D/refresh" </dev/null; then refreshed=ok; else refreshed=failed; fi
    return 0
  fi
  opts=$refresher_opts
  if [ -f "$CONF" ]; then # keep what was chosen before
    [ "$(conf_value hc)" = off ] && opts="$opts --no-hc"
    [ "$(conf_value host_names)" = lan ] && opts="$opts --lan"
    timer_present || opts="$opts --no-timer"
  fi
  # shellcheck disable=SC2086  # each option a word
  if SHIPSHAPE_SETUP=1 sh "$stage/refresh" install "$me" "$me_key" "$fl_user" "$fl_hosts" "ssh-ed25519 $fl_blob" $opts </dev/null; then
    refreshed=ok
  else
    refreshed=failed
  fi
  [ -x "$D/refresh" ] || die "The refresher did not install (above)."
}

# --- Herdr: the Desk, the Fleet panel and its settings ---------------------------------------------
herdr_here() { command -v herdr-app >/dev/null 2>&1 || [ -d "$HERDR_HOME" ]; }

fetch_package() {
  your_ssh "$DEST" ship-fleet machine-setup --package 2>"$stage/package.err" \
    | head -c $((MAX_PACKAGE + 1)) >"$stage/package.tgz"
  if [ "$(wc -c <"$stage/package.tgz")" -ne "$package_bytes" ] \
    || [ "$(sha256 "$stage/package.tgz")" != "$package_sha" ]; then
    die "FleetLedger's package is not the one its setup data names: not installed."
  fi
  tar -tzf "$stage/package.tgz" >"$stage/package.list" 2>/dev/null || die "FleetLedger's package does not unpack."
  # Plain files only: no link, device or folder entry that could point outside it.
  tar -tvzf "$stage/package.tgz" 2>/dev/null | cut -c 1 | grep -qv '^-$' \
    && die "FleetLedger's package holds something other than plain files: not installed."
  while IFS= read -r x; do
    case $x in
      shipshape-setup | herdr/*) ;;
      *) die "FleetLedger's package holds $x, which it should not: not installed." ;;
    esac
    case /$x/ in */../* | *//*) die "FleetLedger's package holds $x, which it should not: not installed." ;; esac
  done <"$stage/package.list"
  if ! { mkdir "$stage/package" && tar -xzf "$stage/package.tgz" -C "$stage/package" 2>/dev/null; }; then
    die "FleetLedger's package does not unpack."
  fi
  source_dir="$stage/package"
}

install_herdr() {
  if [ -z "$source_dir" ] && [ -d "$HERDR_HOME/mods/fleet" ]; then
    mods_said="kept as they are: this computer cannot fetch newer ones from FleetLedger (its key has no shell there); from a ShipShape checkout, shipshape-setup --herdr-client updates them."
    return 0
  fi
  if [ -z "$source_dir" ]; then
    mods_said="not installed: no ShipShape checkout here, and this computer cannot fetch them from FleetLedger (its key has no shell there). Run shipshape-setup --herdr-client from a ShipShape checkout here."
    return 1
  fi
  command -v bash >/dev/null 2>&1 || { mods_said="not installed: the Desk's install script needs bash."; return 1; }
  if ! bash "$source_dir/herdr/install-desk.sh" </dev/null >"$stage/desk.out" 2>"$stage/desk.err"; then
    sed 's/^/  /' "$stage/desk.err" >&2
    mods_said="not installed: the Desk's install script failed (above)."
    said_fail=1
    return 1
  fi
  sed 's/^/  /' "$stage/desk.err" >&2
  mods_said="installed into $HERDR_HOME"
}

# shellcheck disable=SC2088  # ~ is for the Fleet panel, which expands it
tilde() { case $1 in "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;; *) printf '%s' "$1" ;; esac; }

# The Fleet panel's settings.json: where FleetLedger is, and the key, filled in only where
# you have not set them. A file with anything else in it is left as it is.
fill_settings() {
  [ "$shell" = yes ] || { settings_said="none: this computer has no shell on FleetLedger, so the panel shows its Ships from ~/.ssh/shipshape/fleet.json"; return 0; }
  [ -d "${SETTINGS%/*}" ] || { settings_said="none (no Fleet panel)"; return 0; }
  want_ident=null
  case $accepted in
    /*" agent"* | *" agent") ;;
    /*)
      p=${accepted%% *}
      is_path "$p" && [ -f "$p" ] && want_ident="\"$(tilde "$p")\"" ;;
  esac
  cur_ssh='' cur_ident=''
  if [ -s "$SETTINGS" ]; then
    if ! flat "$SETTINGS" >"$stage/settings.flat" 2>/dev/null \
      || awk -F '\t' '$1 != "ssh" && $1 != "identity_file" { bad = 1 } END { exit !bad }' "$stage/settings.flat"; then
      settings_said="left as it is: $SETTINGS holds more than ssh and identity_file, or is not plain JSON"
      return 0
    fi
    cur_ssh=$(field "$stage/settings.flat" ssh)
    cur_ident=$(field "$stage/settings.flat" identity_file)
  fi
  set_ssh=0 set_ident=0
  { [ -z "$cur_ssh" ] || [ "$cur_ssh" = null ]; } && set_ssh=1
  # The key only goes with the destination it logged in to: beside an ssh value of yours
  # for somewhere else it stays as you left it.
  { [ -z "$cur_ident" ] || [ "$cur_ident" = null ]; } && [ "$want_ident" != null ] \
    && { [ "$set_ssh" = 1 ] || [ "$cur_ssh" = "$DEST" ]; } && set_ident=1
  if [ "$set_ssh" = 0 ] && [ "$set_ident" = 0 ] && [ -f "$SETTINGS" ]; then
    settings_said="yours, unchanged"
    return 0
  fi
  if [ "$set_ssh" = 1 ]; then out_ssh="\"$DEST\""; else out_ssh="\"$cur_ssh\""; fi
  if [ "$set_ident" = 1 ]; then out_ident=$want_ident
  elif [ -n "$cur_ident" ] && [ "$cur_ident" != null ]; then out_ident="\"$cur_ident\""
  else out_ident=null; fi
  printf '{\n  "ssh": %s,\n  "identity_file": %s\n}\n' "$out_ssh" "$out_ident" >"$stage/settings.json"
  mv -f "$stage/settings.json" "$SETTINGS" || die "Cannot write $SETTINGS."
  settings_said="ssh $out_ssh, identity_file $out_ident"
  [ "$set_ssh" = 0 ] && settings_said="$settings_said (ssh is yours, kept)"
  [ "$set_ident" = 0 ] && [ "$out_ident" != null ] && settings_said="$settings_said (identity_file is yours, kept)"
  return 0
}

install_self() {
  [ -f "$source_dir/shipshape-setup" ] || return 0
  mkdir -p "$BIN" || return 0
  if ! cmp -s "$source_dir/shipshape-setup" "$BIN/shipshape-setup"; then
    cp "$source_dir/shipshape-setup" "$BIN/.shipshape-setup.tmp" && chmod 755 "$BIN/.shipshape-setup.tmp" \
      && mv -f "$BIN/.shipshape-setup.tmp" "$BIN/shipshape-setup" \
      && say "Installed this installer as $BIN/shipshape-setup (run it again to update)."
  fi
}

# A newer installer from FleetLedger does the rest itself, once (it is the one FleetLedger's
# package names, checked by its SHA-256 like the rest of the package).
newer_installer() {
  [ -n "${SHIPSHAPE_SETUP_HANDED:-}" ] && return 1
  if [ -z "$self" ] || [ ! -f "$self" ]; then return 1; fi
  [ -f "$source_dir/shipshape-setup" ] || return 1
  cmp -s "$source_dir/shipshape-setup" "$self" && return 1
  return 0
}

hand_over() {
  next=$(mktemp -d "${TMPDIR:-/tmp}/shipshape-setup.XXXXXX") || die "Cannot run FleetLedger's installer."
  cp "$source_dir/shipshape-setup" "$next/shipshape-setup" || die "Cannot run FleetLedger's installer."
  args="--herdr-client --fleetledger $DEST --name $me"
  [ -n "$want_fp" ] && args="$args --host-key-fingerprint $want_fp"
  [ "$no_open" = 1 ] && args="$args --no-open"
  [ "$no_herdr" = 1 ] && args="$args --no-herdr"
  args="$args $refresher_opts"
  cleanup
  SHIPSHAPE_SETUP_HANDED=$next
  export SHIPSHAPE_SETUP_HANDED
  # shellcheck disable=SC2086  # each option a word, each checked
  exec sh "$next/shipshape-setup" $args
}

# --- the roles -----------------------------------------------------------------------------------
role_herdr_client() {
  if [ -n "$want_dest" ]; then DEST=$want_dest
  else
    DEST=$(remembered_dest)
    if [ -z "$DEST" ]; then
      DEST=$DEFAULT_DEST
      say "Looking for FleetLedger at ${DEFAULT_DEST#*@}, the name its VM is made with (elsewhere: --fleetledger USER@HOST)."
      say "Make sure this computer is on the same network (your LAN or tailnet) as FleetLedger's VM."
    fi
  fi
  is_dest "$DEST" || usage "Not an ssh destination: $DEST (USER@HOST, or a Host of ~/.ssh/config)."
  say "FleetLedger: $DEST"
  source_dir='' shell=no
  if pin_host_key; then
    fetch_setup
  else
    warn "$unreachable"
    access_said="FleetLedger cannot be reached"
  fi
  if [ "$shell" = yes ]; then
    identify
    if [ -z "$me" ]; then
      trust_here
      fetch_setup
      [ "$shell" = yes ] || die "FleetLedger stopped answering $DEST after trusting this computer."
      want_name=$name
      identify
      [ -n "$me" ] || die "FleetLedger trusts $name, but its setup data does not list it with this computer's key."
    fi
    say "This computer is $me on FleetLedger."
    fetch_package
    if newer_installer; then
      say "FleetLedger has another version of this installer; it does the rest."
      install_self
      hand_over
    fi
  else
    paired=''
    if [ ! -f "$CONF" ]; then
      no_credentials # paired by code, or it stops here
      paired=1
    else
      # Set up before (the pasted line, or a pairing): the refresher knows this computer.
      me=$(conf_value name) me_key=$(conf_value key)
      if ! is_name "$me" || ! is_path "$me_key"; then die "$CONF is not one this installer reads."; fi
      refreshed=''
      if "$D/refresh" </dev/null; then refreshed=ok; else refreshed=failed; fi
    fi
    if [ -f "$here_dir/herdr/install-desk.sh" ]; then source_dir=$here_dir; fi
  fi
  if [ "$shell" = yes ] || [ -n "$paired" ]; then
    install_refresher
  fi
  mods_said="skipped (--no-herdr)" settings_said="skipped" opened=''
  if [ "$no_herdr" != 1 ]; then
    if herdr_here; then
      if install_herdr; then
        fill_settings
        # The Fleet tab: the open one (fleet.open, while one is open), else a new one.
        if [ "$no_open" != 1 ] && command -v herdr-app >/dev/null 2>&1; then
          if herdr-app 'do' fleet.open </dev/null >/dev/null 2>&1 \
            || herdr-app 'do' tab.new "$TAB" </dev/null >/dev/null 2>&1; then
            opened=1
          fi
        fi
      fi
    else
      mods_said="not installed: Herdr is not installed here (no herdr-app, no $HERDR_HOME). Install Herdr, then run shipshape-setup again."
    fi
  fi
  [ -n "$source_dir" ] && install_self
  say ""
  say "Set up $me as a Herdr client of FleetLedger at $DEST:"
  if [ "$refreshed" = ok ]; then how="refreshed now"
  else how="its refresh FAILED (above); it tries again hourly"; fi
  timer_present && how="$how, at login and hourly"
  say "  the refresher: ~/.ssh/shipshape/refresh, $how"
  say "  the Desk and the Fleet panel: $mods_said"
  say "  the Fleet panel's settings.json: $settings_said"
  if [ -n "$opened" ]; then
    say "Opened the Fleet tab in Herdr."
  elif [ -d "$HERDR_HOME/mods/fleet" ]; then
    say "Open the Fleet tab: herdr-app do tab.new '$TAB'"
  fi
  [ -d "$HERDR_HOME/mods/desk" ] && say "The Desk layout: herdr-app do layout.switch '{\"name\":\"desk\"}' (or ctrl-shift-l)."
  if command -v shipshape-setup >/dev/null 2>&1; then later=shipshape-setup
  elif [ -x "$BIN/shipshape-setup" ]; then later="$BIN/shipshape-setup (~/.local/bin is not on your PATH)"
  else later="shipshape-setup --herdr-client, from a ShipShape checkout"; fi
  say "To update all of this later: $later; it asks nothing on a computer set up before."
  [ "$refreshed" = ok ] && [ -z "$said_fail" ]
}

role_fleetledger_here() {
  say "FleetLedger here:"
  if [ -x "$here_dir/fleetledger/install.sh" ]; then
    bash "$here_dir/fleetledger/install.sh" </dev/null || { warn "fleetledger/install.sh failed (above)."; return 1; }
    PATH="$PATH:$HOME/.local/bin"
  fi
  if command -v ship-fleet >/dev/null 2>&1; then
    say "Now FleetLedger's own setup, in your browser (stop and come back at any point):"
    if can_ask; then ship-fleet setup </dev/tty; else ship-fleet setup; fi
    return $?
  fi
  if [ -x "$here_dir/fleetledger/install.sh" ]; then
    warn "  fleetledger/install.sh ran, but ship-fleet is not on PATH: open a new terminal (pipx puts it in ~/.local/bin), then run ship-fleet setup."
    return 1
  fi
  warn "  not available from here: FleetLedger installs from a ShipShape checkout. Clone the repository, then run its ./shipshape-setup --fleetledger-here (README.md)."
  return 1
}

role_fleetledger_remote() {
  warn "Another computer as FleetLedger's host: not available as one step yet."
  warn "  Today, on a computer with FleetLedger: ship-fleet appliance seed (a VM's seed for Proxmox), the printed Proxmox steps, then ship-fleet migrate push (docs/runbooks/fleetledger-vm.md)."
  return 1
}

role_ship_host() {
  warn "This computer as a host for Ships: not available yet."
  warn "  Ships run on Proxmox, which FleetLedger drives (or on machines you make by hand: the manual driver); see docs/runbooks/proxmox-setup.md."
  return 1
}

choose_roles() {
  if [ -f "$CONF" ] || [ -d "$HERDR_HOME/mods/fleet" ]; then
    say "This computer was set up before as a Herdr client: updating it (other roles: shipshape-setup --help)."
    r_client=1
    return
  fi
  can_ask || usage "Say what this computer should be: --herdr-client, --fleetledger-here, --fleetledger-remote, --ship-host (several at once are fine)."
  say "What should this computer be? Type the numbers (several at once are fine):"
  say "  1) FleetLedger's host: run FleetLedger here"
  say "  2) Set up another computer (a VM) as FleetLedger's host"
  say "  3) A host for Ships"
  say "  4) A Herdr client: see and manage Ships from Herdr here"
  ask "Roles [4]: "
  for a in ${answer:-4}; do
    case $a in
      1) r_here=1 ;;
      2) r_remote=1 ;;
      3) r_ship=1 ;;
      4) r_client=1 ;;
      *) usage "Not a choice: $a" ;;
    esac
  done
}

main() {
  if [ -z "${HOME:-}" ] || [ ! -d "$HOME" ]; then die "HOME is not set."; fi
  r_here=0 r_remote=0 r_ship=0 r_client=0
  want_dest='' want_fp='' want_name='' want_scope='' want_logins='' yes=0 no_open=0 no_herdr=0
  no_pairing=0 paired=''
  refresher_opts=''
  while [ "$#" -gt 0 ]; do
    case $1 in
      --herdr-client) r_client=1 ;;
      --fleetledger-here) r_here=1 ;;
      --fleetledger-remote) r_remote=1 ;;
      --ship-host) r_ship=1 ;;
      --fleetledger) [ "$#" -ge 2 ] || usage "--fleetledger needs USER@HOST"; want_dest=$2; shift ;;
      --host-key-fingerprint)
        [ "$#" -ge 2 ] || usage "--host-key-fingerprint needs SHA256:..."
        case $2 in SHA256:*) ;; *) usage "A fingerprint starts SHA256:" ;; esac
        case ${2#SHA256:} in '' | *[!A-Za-z0-9+/=]*) usage "Not a fingerprint: $2" ;; esac
        want_fp=$2; shift ;;
      --name)
        if [ "$#" -lt 2 ] || ! is_name "$2"; then usage "--name needs a machine name (a-z, 0-9 and -, up to 31)"; fi
        want_name=$2; shift ;;
      --scope)
        if [ "$#" -lt 2 ] || ! is_scope "$2"; then usage "--scope is all, tag:TAG or ship:NAME"; fi
        want_scope="${want_scope:+$want_scope }$2"; shift ;;
      --logins) case ${2:-} in agent | owner | both) want_logins=$2 ;; *) usage "--logins is agent, owner or both" ;; esac; shift ;;
      --yes) yes=1 ;;
      --no-pairing) no_pairing=1 ;;
      --no-open) no_open=1 ;;
      --no-herdr) no_herdr=1 ;;
      --no-timer | --no-hc | --lan) refresher_opts="$refresher_opts $1" ;;
      -h | --help) sed -n '2,/^$/s/^# \{0,1\}//p' "$self" 2>/dev/null || say "See docs/runbooks/trust-machines.md, \"Set up or update\"."; exit 0 ;;
      *) usage "Unknown option $1" ;;
    esac
    shift
  done
  case " $want_scope " in *" all "*) [ "$want_scope" = all ] || usage "--scope all goes alone." ;; esac
  if [ $((r_here + r_remote + r_ship + r_client)) -eq 0 ]; then choose_roles; fi
  for tool in ssh ssh-keygen awk sed grep tar cmp; do
    command -v "$tool" >/dev/null 2>&1 || die "This installer needs $tool."
  done
  stage=$(mktemp -d "${TMPDIR:-/tmp}/shipshape-setup.XXXXXX") || die "Cannot make a folder to work in."
  trap 'cleanup; exit 1' HUP INT TERM
  status=0
  if [ "$r_here" = 1 ]; then role_fleetledger_here || status=1; fi
  if [ "$r_remote" = 1 ]; then role_fleetledger_remote || status=1; fi
  if [ "$r_ship" = 1 ]; then role_ship_host || status=1; fi
  if [ "$r_client" = 1 ]; then
    for tool in ssh-keyscan base64; do
      command -v "$tool" >/dev/null 2>&1 || die "The Herdr client needs $tool."
    done
    role_herdr_client || status=1
  fi
  cleanup
  exit "$status"
}

# Where it runs from: a ShipShape checkout (the Desk's mods, FleetLedger's install), or not
# a file at all (ssh ... ship-fleet machine-setup --installer | sh).
case $0 in
  */shipshape-setup | shipshape-setup) self=$0 here_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd) ;;
  *) self='' here_dir='' ;;
esac
if [ -z "$here_dir" ] || [ ! -f "$here_dir/shipshape-setup" ]; then here_dir=/nonexistent; fi
main "$@" </dev/null
