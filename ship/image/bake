#!/usr/bin/env bash
# bake: make a baked Ship base image from Ubuntu's verified cloud image (phase 4).
#
# Interface: contracts/image.md. FleetLedger runs it (`ship-fleet image build`);
# it is Ship-track code because it runs ship-provision inside the image.
#
# usage: bake --base IMG --bundle BUNDLE.tar.gz --manifest MANIFEST.json --out OUT.qcow2
#             [--backend virt-customize|qemu] [--grow SIZE]
#
#   --base      Ubuntu's cloud image, already verified by the caller; its sha256
#               must equal manifest.ubuntu.sha256. Never modified (a copy is baked).
#   --bundle    a tooling bundle (contracts/seed.md) from the same checkout
#   --manifest  the image manifest to bake in (no sha256; contracts/image.md)
#   --out       the finished, compressed qcow2; written only on success
#   --backend   virt-customize (default): libguestfs, offline, nothing booted.
#               qemu: one local QEMU boot with a throwaway NoCloud seed served
#               over loopback HTTP, that bakes and powers off.
#   --grow      grow the copy's disk by SIZE first (default 6G), for the packages
#
# Inside the image it runs `ship-provision --bake --recipes <manifest.recipes>`,
# writes /etc/shipshape/image.json, then image-clean.sh. Never puts a user, a key,
# a seed or a secret into the image.
set -euo pipefail
shopt -s inherit_errexit

HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
BASE="" BUNDLE="" MANIFEST="" OUT="" BACKEND=virt-customize GROW=6G
TIMEOUT=${SHIPSHAPE_BAKE_TIMEOUT:-2400}
# SHIPSHAPE_BAKE_KEEP=1 keeps the work folder (disk copy, console log) for debugging.
# This computer, as QEMU's user network shows it to the guest (fixed by QEMU).
QEMU_HOST=10.0.2.2 # hygiene: allow (QEMU's built-in address, not a real network)
MARKER=SHIPSHAPE-BAKE-OK

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }
log() { printf 'bake: %s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found. $2"; }

while [ $# -gt 0 ]; do
  case $1 in
    --base | --bundle | --manifest | --out | --backend | --grow)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      case $1 in
        --base) BASE=$2 ;;
        --bundle) BUNDLE=$2 ;;
        --manifest) MANIFEST=$2 ;;
        --out) OUT=$2 ;;
        --backend) BACKEND=$2 ;;
        --grow) GROW=$2 ;;
      esac
      shift
      ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done
if [ -z "$BASE" ] || [ -z "$BUNDLE" ] || [ -z "$MANIFEST" ] || [ -z "$OUT" ]; then
  usage >&2
  exit 2
fi
case $BACKEND in virt-customize | qemu) ;; *) die "--backend is virt-customize or qemu" ;; esac
[[ $GROW =~ ^[0-9]+[MG]$ ]] || die "--grow takes a size like 6G"
for f in "$BASE" "$BUNDLE" "$MANIFEST"; do [ -f "$f" ] || die "$f does not exist"; done
[ ! -e "$OUT" ] || die "$OUT already exists; not overwriting it"

need qemu-img "Install qemu-utils."
need python3 ""
need sha256sum ""

# manifest FIELD: one value from the manifest (dotted path; lists joined with commas).
manifest() {
  python3 -I -c '
import json, sys
node = json.load(open(sys.argv[1]))
for part in sys.argv[2].split("."):
    node = node[part]
print(",".join(node) if isinstance(node, list) else node)
' "$MANIFEST" "$1"
}

[ "$(manifest schema)" = shipshape.image/1 ] || die "$MANIFEST is not an image manifest"
python3 -I -c 'import json, sys; sys.exit("sha256" in json.load(open(sys.argv[1])))' "$MANIFEST" ||
  die "the manifest to bake in must not carry sha256 (contracts/image.md)"
want=$(manifest ubuntu.sha256)
have=$(sha256sum "$BASE" | awk '{print $1}')
[ "$have" = "$want" ] || die "$BASE has sha256 $have, the manifest says $want"
RECIPES=$(manifest recipes)
ID=$(manifest id)

WORK=$(mktemp -d "${TMPDIR:-/tmp}/shipshape-bake.XXXXXX")
chmod 0700 "$WORK"
SERVER_PID=""
cleanup() {
  [ -z "$SERVER_PID" ] || kill "$SERVER_PID" 2>/dev/null || true
  if [ -n "${SHIPSHAPE_BAKE_KEEP:-}" ]; then
    log "kept the work folder for debugging: $WORK"
  else
    rm -rf "$WORK"
  fi
}
trap cleanup EXIT

log "baking $ID from $(basename "$BASE") with $BACKEND"
qemu-img convert -q -O qcow2 "$BASE" "$WORK/disk.qcow2"
qemu-img resize -q "$WORK/disk.qcow2" "+$GROW"

# The script run inside the image (both backends). $1: the folder holding the
# unpacked bundle, image.json and image-clean.sh.
cat >"$WORK/inside.sh" <<'INSIDE'
set -euo pipefail
dir=$1 recipes=$2
export DEBIAN_FRONTEND=noninteractive
# The copy was grown: grow the root filesystem into it. The cloud image's root is
# partition 1, at the end of the disk. Under QEMU cloud-init has already done it.
root=$(findmnt -no SOURCE / 2>/dev/null || true)
case $root in
  /dev/*[0-9])
    disk=/dev/$(lsblk -no PKNAME "$root" 2>/dev/null | head -n1)
    growpart "$disk" "${root##*[!0-9]}" || true # NOCHANGE: nothing to grow
    resize2fs "$root" >/dev/null 2>&1 || true
    ;;
esac
df -h / | tail -n1
# A booted copy (qemu backend) runs apt jobs of its own at boot: stop them, and have
# every apt call wait for the lock rather than fail. The setting lives in the bake's
# folder, not in the image.
if [ -d /run/systemd/system ]; then
  systemctl stop apt-daily.timer apt-daily-upgrade.timer apt-daily.service \
    apt-daily-upgrade.service unattended-upgrades.service apt-news.service \
    esm-cache.service 2>/dev/null || true
fi
printf 'DPkg::Lock::Timeout "600";\n' >"$dir/apt.conf"
export APT_CONFIG=$dir/apt.conf
"$dir/bundle/provision/ship-provision" --bake ${recipes:+--recipes "$recipes"}
install -d -m 0755 /etc/shipshape
install -m 0644 "$dir/image.json" /etc/shipshape/image.json
INSIDE

mkdir -p "$WORK/payload/bundle"
tar -xzf "$BUNDLE" -C "$WORK/payload/bundle"
[ -x "$WORK/payload/bundle/provision/ship-provision" ] || die "the bundle has no provision/ship-provision"
cp "$MANIFEST" "$WORK/payload/image.json"
cp "$HERE/image-clean.sh" "$WORK/payload/image-clean.sh"
cp "$WORK/inside.sh" "$WORK/payload/inside.sh"
tar -czf "$WORK/payload.tar.gz" -C "$WORK/payload" .

bake_virt_customize() {
  need virt-customize "Install libguestfs-tools, or use --backend qemu."
  # --no-logfile: keep the build log out of the image.
  virt-customize -a "$WORK/disk.qcow2" --network --no-logfile \
    --mkdir /var/tmp/shipshape-bake \
    --copy-in "$WORK/payload.tar.gz:/var/tmp/shipshape-bake" \
    --run-command "tar -xzf /var/tmp/shipshape-bake/payload.tar.gz -C /var/tmp/shipshape-bake" \
    --run-command "bash /var/tmp/shipshape-bake/inside.sh /var/tmp/shipshape-bake '$RECIPES'" \
    --run-command "bash /var/tmp/shipshape-bake/image-clean.sh" \
    --run-command "rm -rf /var/tmp/shipshape-bake"
}

bake_qemu() {
  need qemu-system-x86_64 "Install qemu-system-x86."
  local seed=$WORK/seed port accel=(-accel tcg)
  mkdir -p "$seed"
  cp "$WORK/payload.tar.gz" "$seed/payload.tar.gz"
  port=$(python3 -I -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')
  printf 'instance-id: shipshape-bake-%s\nlocal-hostname: shipshape-bake\n' "$ID" >"$seed/meta-data"
  : >"$seed/vendor-data"
  printf 'version: 2\nethernets:\n  primary:\n    match:\n      name: "e*"\n    dhcp4: true\n' \
    >"$seed/network-config"
  # runcmd provisions; the clean-up then runs from a unit ordered after cloud-init's
  # last stage (in /run, so it is not in the image), and the copy powers off cleanly.
  # On any failure it powers off at once; the console marker says which.
  cat >"$seed/user-data" <<USERDATA
#cloud-config
users: []
ssh_pwauth: false
disable_root: true
write_files:
  - path: /run/systemd/system/shipshape-bake-finish.service
    permissions: "0644"
    content: |
      [Unit]
      Description=ShipShape bake: clean up, then power off
      After=cloud-final.service
      [Service]
      Type=oneshot
      ExecStart=/bin/bash -c 'journalctl --relinquish-var; if bash /var/tmp/shipshape-bake/image-clean.sh > /dev/ttyS1 2>&1; then rm -rf /var/tmp/shipshape-bake; echo $MARKER > /dev/ttyS0; else echo SHIPSHAPE-BAKE-FAILED > /dev/ttyS0; fi'
      ExecStartPost=/bin/systemctl poweroff --no-block
runcmd:
  - [bash, -c, "d=/var/tmp/shipshape-bake; if mkdir -p \$d && curl -fsS http://$QEMU_HOST:$port/payload.tar.gz -o \$d/payload.tar.gz && tar -xzf \$d/payload.tar.gz -C \$d && bash \$d/inside.sh \$d '$RECIPES' > /dev/ttyS1 2>&1; then systemctl daemon-reload; systemctl start --no-block shipshape-bake-finish.service; else echo SHIPSHAPE-BAKE-FAILED > /dev/ttyS0; sync; systemctl poweroff --force; fi"]
USERDATA
  python3 -I -m http.server --bind 127.0.0.1 --directory "$seed" "$port" >/dev/null 2>&1 &
  SERVER_PID=$!
  [ -w /dev/kvm ] && accel=(-accel kvm -cpu host)
  log "booting the copy in QEMU; this takes 5 to 15 minutes"
  timeout "$TIMEOUT" qemu-system-x86_64 "${accel[@]}" -m 4096 -smp 4 \
    -drive "file=$WORK/disk.qcow2,if=virtio,discard=unmap" \
    -nic user,model=virtio-net-pci \
    -smbios "type=1,serial=ds=nocloud;s=http://$QEMU_HOST:$port/" \
    -serial "file:$WORK/console.log" -serial "file:$WORK/bake-output.log" \
    -monitor none -display none || {
    tail -n 60 "$WORK/bake-output.log" >&2 || true
    die "QEMU failed or did not finish within ${TIMEOUT}s; the bake's last lines are above"
  }
  if ! grep -q "$MARKER" "$WORK/console.log"; then
    tail -n 60 "$WORK/bake-output.log" >&2 || true
    die "the bake inside QEMU failed; its last lines are above (SHIPSHAPE_BAKE_KEEP=1 keeps the console log)"
  fi
}

"bake_${BACKEND//-/_}"

log "compressing"
qemu-img convert -q -c -O qcow2 "$WORK/disk.qcow2" "$WORK/out.qcow2"
mv "$WORK/out.qcow2" "$OUT"
log "done: $OUT"
