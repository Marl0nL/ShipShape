#!/usr/bin/env bash
# ship-provision: turn a fresh Ubuntu cloud image into a Ship (W4).
#
# Makes contracts/ship-runtime.md true. Idempotent: every step checks before it
# changes anything, so a second run reports 0 changes. Versions, checksums and
# signing keys come from versions.toml at the bundle root.
#
# usage: ship-provision --first-boot|--converge|--bake [--recipes ID,...] [--dry-run] [--root DIR]
#
#   --first-boot  run by the seed's bootstrap (contracts/seed.md); also applies
#                 ship.toml, installs the catalogue tools and starts herdr
#   --converge    run by `ship-ctl converge` (which then runs apply and tools)
#   --bake        run inside an image by ship/image/bake (contracts/image.md): only
#                 the system layer every Ship shares (packages, apt repos, herdr,
#                 uv) plus the apt packages of the bake recipes given with
#                 --recipes. No users, keys, settings or services; no record.
#   --dry-run     change nothing; print what would change
#   --root DIR    treat DIR as / (tests, image work): files are written under DIR,
#                 system commands and downloads are skipped. SHIPSHAPE_ROOT does
#                 the same.
set -euo pipefail
shopt -s inherit_errexit
umask 022

HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
BUNDLE=$(dirname "$HERE")
FILES=$BUNDLE/files
VERSIONS=$BUNDLE/versions.toml
[ -f "$VERSIONS" ] || VERSIONS=$(dirname "$BUNDLE")/versions.toml # repo checkout

MODE=""
BAKE_RECIPES=""
DRY=0
ROOT=${SHIPSHAPE_ROOT:-}
CHANGES=0
CHANGED=0
APT_STALE=0
FINISHED=0
SANDBOX=0
APT_UPDATED=0
AGENT=agent
AGENT_HOME=/home/agent

# Ubuntu packages every Ship has (contracts/ship-runtime.md, plan "What is on a Ship").
BASE_PACKAGES=(ca-certificates curl gnupg git jq tmux ripgrep python3 build-essential
  avahi-daemon unattended-upgrades qemu-guest-agent unzip xz-utils nftables)
# Third-party repos whose packages every Ship has. Other repos are added too, but
# their packages come from recipes (Google Chrome for chrome-devtools-axi).
CORE_REPOS=(github-cli google-cloud nodesource)

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }
log() { printf 'ship-provision: %s\n' "$*"; }
die() { log "error: $*" >&2; exit 1; }

# --- helpers -----------------------------------------------------------------
# cfg FILE KEY: a value from a TOML file (dotted key). Tables print their keys and
# arrays their items, one per line; a missing key prints nothing.
cfg() {
  python3 -I -c '
import sys, tomllib
with open(sys.argv[1], "rb") as fh:
    node = tomllib.load(fh)
for part in sys.argv[2].split("."):
    node = node.get(part) if isinstance(node, dict) else None
    if node is None:
        sys.exit(0)
if isinstance(node, dict):
    print("\n".join(node))
elif isinstance(node, list):
    print("\n".join(str(x) for x in node))
elif isinstance(node, bool):
    print("true" if node else "false")
else:
    print(node)
' "$1" "$2"
}
v() { cfg "$VERSIONS" "$1"; }

changed() {
  CHANGES=$((CHANGES + 1))
  if [ "$DRY" = 1 ]; then log "would change: $*"; else log "changed: $*"; fi
}

# sys CMD...: a command that changes the system. Logged, not run, when simulating.
sys() {
  if [ "$SANDBOX" = 1 ]; then log "skipped (--root): $*"; return 0; fi
  if [ "$DRY" = 1 ]; then log "would run: $*"; return 0; fi
  "$@"
}

# sys_change DESC CMD...: a counted change made by a system command.
sys_change() {
  local desc=$1
  shift
  if [ "$SANDBOX" = 1 ]; then log "skipped (--root): $desc"; return 0; fi
  changed "$desc"
  sys "$@"
}

as_agent() {
  local uid
  uid=$(id -u "$AGENT")
  runuser -u "$AGENT" -- env -i HOME="$AGENT_HOME" USER="$AGENT" LOGNAME="$AGENT" \
    PATH="$AGENT_HOME/.local/bin:/usr/local/bin:/usr/bin:/bin" LANG=C.UTF-8 \
    XDG_RUNTIME_DIR="/run/user/$uid" npm_config_prefix="$AGENT_HOME/.local" "$@"
}

same_meta() { # PATH MODE OWNER
  [ "$((8#$(stat -c %a "$1")))" = "$((8#$2))" ] || return 1
  [ -n "$ROOT" ] || [ "$(stat -c %U:%G "$1")" = "$3" ]
}

# Root-owned paths only: the agent's home goes through home_dir and home_npmrc,
# which run as the agent (a symlink there must never redirect a root write).
not_in_home() {
  case $1 in
    "$AGENT_HOME" | "$AGENT_HOME"/*) die "internal: $1 is in the agent's home" ;;
  esac
}

# Create a missing parent folder; never re-mode an existing one.
ensure_parent() { [ -d "$1" ] || install -d -m 0755 "$1"; }

# put_file SRC DEST MODE [OWNER]: install SRC as DEST if content, mode or owner differ.
put_file() {
  local src=$1 dest=$2 mode=$3 owner=${4:-root:root}
  local real=$ROOT$dest
  not_in_home "$dest"
  CHANGED=0
  if [ -f "$real" ] && [ ! -L "$real" ] && cmp -s "$src" "$real" && same_meta "$real" "$mode" "$owner"; then
    return 0
  fi
  CHANGED=1
  changed "$dest"
  [ "$DRY" = 1 ] && return 0
  ensure_parent "$(dirname "$real")"
  if [ -n "$ROOT" ]; then
    install -m "$mode" "$src" "$real"
  else
    install -o "${owner%%:*}" -g "${owner##*:}" -m "$mode" "$src" "$real"
  fi
}

# put_text DEST MODE [OWNER] <<<content
put_text() {
  local tmp
  tmp=$(mktemp)
  cat >"$tmp"
  put_file "$tmp" "$@"
  rm -f "$tmp"
}

put_dir() { # DIR MODE [OWNER]
  local dir=$1 mode=$2 owner=${3:-root:root}
  local real=$ROOT$dir
  not_in_home "$dir"
  if [ -d "$real" ] && [ ! -L "$real" ] && same_meta "$real" "$mode" "$owner"; then return 0; fi
  changed "$dir/"
  [ "$DRY" = 1 ] && return 0
  if [ -n "$ROOT" ]; then
    install -d -m "$mode" "$real"
  else
    install -d -o "${owner%%:*}" -g "${owner##*:}" -m "$mode" "$real"
  fi
}

# drop_file PATH: remove a file or link an older release installed.
drop_file() {
  local real=$ROOT$1
  not_in_home "$1"
  [ -e "$real" ] || [ -L "$real" ] || return 1
  changed "removed $1"
  [ "$DRY" = 1 ] || rm -f "$real"
}

put_link() { # TARGET LINK
  local real=$ROOT$2
  not_in_home "$2"
  CHANGED=0
  [ "$(readlink "$real" 2>/dev/null || true)" = "$1" ] && return 0
  CHANGED=1
  changed "$2 -> $1"
  [ "$DRY" = 1 ] && return 0
  ensure_parent "$(dirname "$real")"
  ln -sfn "$1" "$real"
}

fetch() {
  curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 \
    --connect-timeout 20 --max-time 900 "$@"
}

machine() { if [ -n "$ROOT" ]; then echo x86_64; else uname -m; fi; }
deb_arch() { if [ -n "$ROOT" ]; then echo amd64; else dpkg --print-architecture; fi; }

boot_id() { cat /proc/sys/kernel/random/boot_id 2>/dev/null || true; }

record() { # RESULT: ship-provision's record, read by ship-ctl status (internal)
  [ "$DRY" = 1 ] && return 0
  # A baked image must not claim a provisioning run: first boot makes the record.
  [ "$MODE" = bake ] && return 0
  local dir=$ROOT/var/lib/shipshape
  ensure_parent "$dir"
  printf '{"result": "%s", "mode": "%s", "pid": %d, "boot_id": "%s", "last_run": "%s"}\n' \
    "$1" "$MODE" "$$" "$(boot_id)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$dir/.provision.json.tmp"
  mv "$dir/.provision.json.tmp" "$dir/provision.json"
}

on_exit() {
  local rc=$?
  if [ "$FINISHED" != 1 ]; then
    record failed || true
    log "failed (exit $rc); see the lines above"
  fi
}

# --- apt ---------------------------------------------------------------------
missing_debs() {
  local pkg
  for pkg in "$@"; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed$' || echo "$pkg"
  done
}

ensure_debs() {
  if [ "$SANDBOX" = 1 ]; then log "skipped (--root): apt packages $*"; return 0; fi
  local missing
  mapfile -t missing < <(missing_debs "$@")
  [ "${#missing[@]}" -gt 0 ] || return 0
  if [ "$APT_STALE" = 1 ] || [ "$APT_UPDATED" = 0 ]; then
    sys apt-get update -q
    APT_STALE=0
    APT_UPDATED=1
  fi
  changed "apt packages: ${missing[*]}"
  sys apt-get install -y -q "${missing[@]}"
}

# The cloud image has no guest agent, and the hypervisor reads the Ship's address
# from it: start it as soon as it is installed, not after the slow steps. (Installing
# the package does not start it.)
start_guest_agent() {
  [ "$MODE" = bake ] && return 0 # nothing runs inside an image being baked
  sys systemctl start qemu-guest-agent || true
}

# The primary keys in a keyring file, one fingerprint per line.
primary_keys() {
  local home
  home=$(mktemp -d)
  GNUPGHOME=$home gpg --batch --show-keys --with-colons "$1" 2>/dev/null |
    awk -F: '$1 == "pub" { p = 1; next } $1 == "fpr" && p { print $10; p = 0 }'
  rm -rf "$home"
}

# keyring_ok FILE ALLOWED: every primary key is pinned, and there is at least one.
keyring_ok() {
  local keys key
  keys=$(primary_keys "$1")
  [ -n "$keys" ] || return 1
  for key in $keys; do grep -qx "$key" <<<"$2" || return 1; done
}

step_apt_repos() {
  local id arch url suite comps key_url fprs archs keyring tmp
  arch=$(deb_arch)
  for id in $(v apt); do
    archs=$(v "apt.$id.architectures")
    if [ -n "$archs" ] && ! grep -qx "$arch" <<<"$archs"; then
      log "apt repo $id: not available for $arch"
      continue
    fi
    url=$(v "apt.$id.url")
    suite=$(v "apt.$id.suite")
    comps=$(v "apt.$id.components" | paste -sd' ')
    key_url=$(v "apt.$id.key_url")
    fprs=$(v "apt.$id.key_fingerprints")
    keyring=/etc/apt/keyrings/shipshape-$id.gpg

    if [ "$SANDBOX" = 1 ]; then
      log "skipped (--root): $keyring from $key_url"
    elif [ -f "$keyring" ] && keyring_ok "$keyring" "$fprs"; then
      :
    elif [ "$DRY" = 1 ]; then
      changed "$keyring (from $key_url)"
    else
      tmp=$(mktemp -d)
      fetch -o "$tmp/key" "$key_url"
      if grep -q 'BEGIN PGP PUBLIC KEY BLOCK' "$tmp/key"; then
        GNUPGHOME=$tmp gpg --batch --dearmor <"$tmp/key" >"$tmp/key.gpg"
      else
        cp "$tmp/key" "$tmp/key.gpg"
      fi
      keyring_ok "$tmp/key.gpg" "$fprs" || die "apt repo $id: signing key is not the pinned key"
      put_file "$tmp/key.gpg" "$keyring" 0644
      rm -rf "$tmp"
      APT_STALE=1
    fi

    {
      echo "# Written by ship-provision from versions.toml [apt.$id]."
      echo "Types: deb"
      echo "URIs: $url"
      echo "Suites: $suite"
      echo "Components: $comps"
      [ -z "$archs" ] || echo "Architectures: $arch"
      echo "Signed-By: $keyring"
    } | put_text "/etc/apt/sources.list.d/shipshape-$id.sources" 0644
    [ "$CHANGED" = 0 ] || APT_STALE=1
  done
}

step_core_packages() {
  local id pkgs=()
  for id in "${CORE_REPOS[@]}"; do
    mapfile -t -O "${#pkgs[@]}" pkgs < <(v "apt.$id.packages")
  done
  ensure_debs "${pkgs[@]}"
  [ "$SANDBOX" = 0 ] && [ "$DRY" = 0 ] || return 0
  local want have
  want=$(v node.major)
  have=$(node --version | sed -E 's/^v([0-9]+).*/\1/')
  [ "$have" = "$want" ] || die "Node.js major version is $have, versions.toml wants $want"
}

# --- pinned binaries -----------------------------------------------------------
step_herdr() {
  local arch url sum tmp
  arch=$(machine)
  url=$(v "herdr.assets.$arch.url")
  sum=$(v "herdr.assets.$arch.sha256")
  [ -n "$url" ] || die "versions.toml has no herdr build for $arch"
  if [ "$SANDBOX" = 1 ]; then log "skipped (--root): herdr download"; return 0; fi
  if [ -f /usr/local/bin/herdr ] && echo "$sum  /usr/local/bin/herdr" | sha256sum -c --status - &&
    same_meta /usr/local/bin/herdr 0755 root:root; then
    return 0
  fi
  if [ "$DRY" = 1 ]; then changed "/usr/local/bin/herdr $(v herdr.version)"; return 0; fi
  tmp=$(mktemp -d)
  fetch -o "$tmp/herdr" "$url"
  echo "$sum  $tmp/herdr" | sha256sum -c --quiet - || die "herdr checksum mismatch"
  put_file "$tmp/herdr" /usr/local/bin/herdr 0755
  rm -rf "$tmp"
}

# herdr-core sits beside herdr until Ships move to it. Root-owned on purpose: it
# does not update itself from a folder it cannot write, so the pin stays the
# version, and its remote launcher finds /usr/local/bin/herdr-core first.
step_herdr_core() {
  local arch url sum tmp
  arch=$(machine)
  url=$(v "herdr_core.assets.$arch.url")
  sum=$(v "herdr_core.assets.$arch.sha256")
  [ -n "$url" ] || die "versions.toml has no herdr-core build for $arch"
  if [ "$SANDBOX" = 1 ]; then log "skipped (--root): herdr-core download"; return 0; fi
  if [ -f /usr/local/bin/herdr-core ] && same_meta /usr/local/bin/herdr-core 0755 root:root &&
    [ "$(cat /var/lib/shipshape/herdr-core.sha256 2>/dev/null)" = "$sum" ] &&
    [ "$(readlink /usr/local/bin/hc 2>/dev/null)" = herdr-core ]; then
    return 0
  fi
  if [ "$DRY" = 1 ]; then changed "/usr/local/bin/herdr-core $(v herdr_core.version)"; return 0; fi
  tmp=$(mktemp -d)
  fetch -o "$tmp/herdr-core.tar.gz" "$url"
  install_herdr_core "$tmp/herdr-core.tar.gz" "$sum"
  rm -rf "$tmp"
}

# install_herdr_core ARCHIVE SHA256: check the archive, then install its binary
# as /usr/local/bin/herdr-core (0755, root) with /usr/local/bin/hc beside it.
install_herdr_core() {
  local archive=$1 sum=$2 dir
  echo "$sum  $archive" | sha256sum -c --quiet - || die "herdr-core checksum mismatch"
  dir=$(mktemp -d)
  tar -xzf "$archive" -C "$dir" --no-same-owner herdr-core || die "herdr-core archive has no herdr-core binary"
  [ -f "$dir/herdr-core" ] && [ ! -L "$dir/herdr-core" ] || die "herdr-core archive has no herdr-core binary"
  put_file "$dir/herdr-core" /usr/local/bin/herdr-core 0755
  put_link herdr-core /usr/local/bin/hc
  # The archive's checksum, so a re-run knows the installed binary is the pinned one.
  echo "$sum" | put_text /var/lib/shipshape/herdr-core.sha256 0644
  rm -rf "$dir"
}

step_uv() {
  local arch url sum tmp version
  arch=$(machine)
  version=$(v uv.version)
  url=$(v "uv.assets.$arch.url")
  sum=$(v "uv.assets.$arch.sha256")
  [ -n "$url" ] || die "versions.toml has no uv build for $arch"
  if [ "$SANDBOX" = 1 ]; then log "skipped (--root): uv download"; return 0; fi
  if [ -x /usr/local/bin/uv ] && [ "$(/usr/local/bin/uv --version | awk '{print $2}')" = "$version" ]; then
    return 0
  fi
  if [ "$DRY" = 1 ]; then changed "/usr/local/bin/uv $version"; return 0; fi
  tmp=$(mktemp -d)
  fetch -o "$tmp/uv.tar.gz" "$url"
  echo "$sum  $tmp/uv.tar.gz" | sha256sum -c --quiet - || die "uv checksum mismatch"
  tar -xzf "$tmp/uv.tar.gz" -C "$tmp" --strip-components=1
  put_file "$tmp/uv" /usr/local/bin/uv 0755
  put_file "$tmp/uvx" /usr/local/bin/uvx 0755
  rm -rf "$tmp"
}

# ship-axi's Node dependencies, from its lockfile, into this release (root-owned).
step_ship_axi() {
  local dir=$BUNDLE/axi want have
  [ -f "$dir/package-lock.json" ] || return 0
  want=$(v npm.axi-sdk-js)
  have=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1]))["version"])' \
    "$dir/node_modules/axi-sdk-js/package.json" 2>/dev/null || true)
  [ "$have" != "$want" ] || return 0
  if [ "$SANDBOX" = 1 ]; then log "skipped (--root): npm ci for ship-axi"; return 0; fi
  changed "ship-axi dependencies (axi-sdk-js $want)"
  [ "$DRY" = 1 ] || (cd "$dir" && npm ci --omit=dev --ignore-scripts --no-audit --no-fund)
}

# --- the agent user --------------------------------------------------------------
# The agent owns its home and can put a symlink anywhere in it, so everything
# below runs AS the agent: a planted link can then only reach the agent's own
# files. With --root (tests) it runs as the caller instead.
as_owner() {
  if [ "$SANDBOX" = 1 ]; then "$@"; else as_agent "$@"; fi
}

home_dir() { # DIR MODE: a folder under the agent's home
  local real=$ROOT$1 want
  want=$(printf %o "$((8#$2))") # 0755 -> 755, as stat prints it
  if as_owner test -d "$real" && ! as_owner test -L "$real" &&
    [ "$(as_owner stat -c %a "$real")" = "$want" ]; then
    return 0
  fi
  changed "$1/"
  [ "$DRY" = 1 ] && return 0
  if as_owner test -L "$real"; then as_owner rm -f "$real"; fi # the link, not its target
  as_owner install -d -m "$2" "$real"
}

home_npmrc() { # npm globals live in the agent's home (contracts/ship-runtime.md)
  local file=$ROOT$AGENT_HOME/.npmrc line="prefix=$AGENT_HOME/.local"
  # test -f first: grep on a FIFO the agent left there would block.
  if as_owner test -f "$file" && ! as_owner test -L "$file" &&
    as_owner grep -qx "$line" "$file" 2>/dev/null; then
    return 0
  fi
  changed "$AGENT_HOME/.npmrc"
  [ "$DRY" = 1 ] && return 0
  # shellcheck disable=SC2016 # expanded by the inner shell
  as_owner bash -c 'set -e
    file=$1 line=$2
    tmp=$(mktemp "$file.XXXXXX")
    {
      if [ -f "$file" ] && [ ! -L "$file" ]; then grep -v "^prefix=" "$file" || true; fi
      echo "$line"
    } >"$tmp"
    chmod 0644 "$tmp"
    mv -fT "$tmp" "$file"' _ "$file" "$line"
}

# gcloud copies each command's output into its log files, so a token a command
# printed (print-access-token) can sit there. ship-ctl's probes write no gcloud
# logs any more; this removes any left from before, as the agent like every
# step in its home (a planted link can only reach the agent's own files).
home_gcloud_logs() {
  local real=$ROOT$AGENT_HOME/.config/gcloud/logs
  if ! as_owner test -e "$real" && ! as_owner test -L "$real"; then
    return 0
  fi
  changed "$AGENT_HOME/.config/gcloud/logs removed (gcloud logs can hold tokens)"
  [ "$DRY" = 1 ] && return 0
  as_owner rm -rf -- "$real"
}

step_agent_home() {
  if [ "$SANDBOX" = 0 ] && ! id "$AGENT" >/dev/null 2>&1; then
    die "user $AGENT does not exist (the seed creates it)"
  fi
  local d
  for d in "$AGENT_HOME/.local" "$AGENT_HOME/.local/bin" "$AGENT_HOME/.local/lib" \
    "$AGENT_HOME/.config" "$AGENT_HOME/.config/herdr" "$AGENT_HOME/.config/shipshape" \
    "$AGENT_HOME/work"; do
    home_dir "$d" 0755
  done
  home_dir "$AGENT_HOME/.claude" 0700 # holds the Claude sign-in
  home_dir "$AGENT_HOME/.local/state" 0700
  home_dir "$AGENT_HOME/.local/state/shipshape" 0700
  # The file inbox (contracts/ship-runtime.md): files a person sends with ship-fleet
  # put land in ~/inbox; ship-ctl writes them in incoming/ first, then links them in.
  home_dir "$AGENT_HOME/.local/state/shipshape/incoming" 0700
  home_dir "$AGENT_HOME/inbox" 0700
  home_npmrc
  home_gcloud_logs
  if [ ! -e "$ROOT/var/lib/systemd/linger/$AGENT" ]; then
    sys_change "lingering for $AGENT" loginctl enable-linger "$AGENT"
  fi
}

step_claude() {
  if [ "$SANDBOX" = 1 ]; then
    log "skipped (--root): Claude Code install and herdr integration"
    return 0
  fi
  if as_agent test -x "$AGENT_HOME/.local/bin/claude"; then
    : # installed; Claude Code updates itself from here on
  else
    local channel platform
    channel=$(cfg "$ROOT/etc/shipshape/ship.toml" claude.update_channel 2>/dev/null || true)
    channel=${channel:-$(v claude.default_channel)}
    case $(machine) in
      x86_64) platform=linux-x64 ;;
      aarch64) platform=linux-arm64 ;;
      *) die "no Claude Code build for $(machine)" ;;
    esac
    changed "Claude Code ($channel channel) for $AGENT"
    if [ "$DRY" = 0 ]; then
      as_agent bash "$HERE/install-claude.sh" "$(v claude.manifest_base)" "$channel" \
        "$(v claude.release_key)" "$(v claude.minimum_version)" "$platform"
    fi
  fi
  # herdr's Claude integration reports each agent's session and state, which
  # ship-ctl's agent record follows (it resumes agents itself, ship/lib/shipctl/record.py).
  if ! as_agent herdr integration status 2>/dev/null | grep -q '^claude: current'; then
    changed "herdr Claude integration"
    [ "$DRY" = 1 ] || as_agent herdr integration install claude
  fi
}

# --- ShipShape's own files -----------------------------------------------------------
step_shipshape_files() {
  put_dir /opt/shipshape 0755
  # The resume shim of releases before the agent record: ship-ctl now launches
  # every resumed agent with its mode flag itself, and herdr resumes nothing.
  if drop_file /opt/shipshape/shim/claude && [ "$DRY" = 0 ]; then
    rmdir "$ROOT/opt/shipshape/shim" 2>/dev/null || true
  fi
  put_file "$FILES/hooks/mode_ledger.py" /opt/shipshape/hooks/mode-ledger 0755
  put_link /opt/shipshape/current/bin/ship-ctl /usr/local/bin/ship-ctl
  if [ -e "$BUNDLE/axi/bin/ship-axi.js" ]; then
    put_link /opt/shipshape/current/axi/bin/ship-axi.js /usr/local/bin/ship-axi
  fi
  put_dir /etc/shipshape 0755
  put_dir /var/lib/shipshape 0755
  put_dir /var/log/shipshape 0750
  put_file "$FILES/profile.d/shipshape.sh" /etc/profile.d/shipshape.sh 0644
}

step_system_config() {
  put_file "$FILES/ssh/10-shipshape.conf" /etc/ssh/sshd_config.d/10-shipshape.conf 0644
  if [ "$CHANGED" = 1 ]; then
    sys sshd -t
    # try-: Ubuntu socket-activates sshd, so ssh.service may not be running yet.
    sys systemctl try-reload-or-restart ssh
  fi
  put_file "$FILES/logind/50-shipshape.conf" /etc/systemd/logind.conf.d/50-shipshape.conf 0644
  if [ "$CHANGED" = 1 ]; then
    # systemd-logind has no reload; restarting it is not worth the risk. The
    # longer shutdown delay applies from the next boot.
    log "logind drop-in changed; it applies from the next boot"
  fi
  put_dir /var/log/journal 2755 root:systemd-journal
  put_file "$FILES/journald/50-shipshape.conf" /etc/systemd/journald.conf.d/50-shipshape.conf 0644
  [ "$CHANGED" = 0 ] || sys systemctl restart systemd-journald
}

step_units() {
  local unit system_changed=0 user_changed=0
  # The two ship-lan-guard units are enabled or disabled by `ship-ctl apply` (lan_guard),
  # ship-wake.timer by `ship-ctl apply` too (wake.after_boot).
  for unit in ship-status.service ship-status.timer ship-lan-guard-early.service \
      ship-lan-guard.service ship-wake.service ship-wake.timer; do
    put_file "$FILES/systemd/system/$unit" "/etc/systemd/system/$unit" 0644
    [ "$CHANGED" = 0 ] || system_changed=1
  done
  put_file "$FILES/systemd/user/herdr.service" /etc/systemd/user/herdr.service 0644
  [ "$CHANGED" = 0 ] || user_changed=1
  # ship-resume (a hidden herdr client that let herdr resume its agents) is gone:
  # the status refresh resumes agents from the agent record.
  drop_file /etc/systemd/user/default.target.wants/ship-resume.service && user_changed=1
  drop_file /etc/systemd/user/ship-resume.service && user_changed=1
  [ "$system_changed" = 0 ] || sys systemctl daemon-reload

  # Enabled through symlinks, so the check works in --root mode too, where
  # systemctl --root makes the same links offline.
  if [ ! -L "$ROOT/etc/systemd/system/timers.target.wants/ship-status.timer" ]; then
    enable_unit "ship-status.timer" ship-status.timer
  fi
  if [ ! -L "$ROOT/etc/systemd/user/default.target.wants/herdr.service" ]; then
    enable_unit "herdr.service for $AGENT" --global herdr.service
  fi
  if [ "$SANDBOX" = 0 ] && [ "$DRY" = 0 ]; then
    systemctl is-active --quiet ship-status.timer || systemctl start ship-status.timer
    systemctl enable --now qemu-guest-agent >/dev/null 2>&1 || true
    if [ "$user_changed" = 1 ] && [ -S "/run/user/$(id -u "$AGENT")/bus" ]; then
      as_agent systemctl --user daemon-reload # takes effect at the next start
    fi
  fi
}

enable_unit() { # DESC [--global] UNIT
  local desc=$1
  shift
  changed "enable $desc"
  [ "$DRY" = 1 ] && return 0
  if [ "$SANDBOX" = 1 ]; then
    systemctl --root="$ROOT" enable "$@" >/dev/null 2>&1 || log "could not enable $desc under --root"
  else
    systemctl enable "$@"
  fi
}

# --- network visibility (phase 3) -----------------------------------------------------
# ship-netwatch records which programs connect where (contracts/ship-ctl.md,
# `ship-ctl net`); vnstat counts bytes per interface. Observation only.
NET_PACKAGES=(libbpf-tools vnstat)

step_netwatch() {
  ensure_debs "${NET_PACKAGES[@]}"
  local unit_changed
  put_file "$FILES/systemd/system/ship-netwatch.service" /etc/systemd/system/ship-netwatch.service 0644
  unit_changed=$CHANGED
  [ "$unit_changed" = 0 ] || sys systemctl daemon-reload
  if [ ! -L "$ROOT/etc/systemd/system/multi-user.target.wants/ship-netwatch.service" ]; then
    enable_unit "ship-netwatch.service" ship-netwatch.service
  fi
  if [ "$SANDBOX" = 0 ] && [ "$DRY" = 0 ]; then
    systemctl enable --now vnstat >/dev/null 2>&1 || log "vnstat did not start"
    # A converge brings a new release of the collector: restart it to pick that up.
    if [ "$unit_changed" = 1 ] || [ "$MODE" = converge ] ||
      ! systemctl is-active --quiet ship-netwatch.service; then
      systemctl restart ship-netwatch.service || log "ship-netwatch did not start"
    fi
  fi
}

# --- first boot: settings, tools, herdr ----------------------------------------------
ship_ctl() { "$BUNDLE/bin/ship-ctl" "$@"; }

step_first_boot() {
  if [ "$SANDBOX" = 1 ] || [ "$DRY" = 1 ]; then
    log "skipped (simulated): ship-ctl apply, ship-ctl tools run, start herdr"
    return 0
  fi
  ship_ctl apply || die "ship-ctl apply failed"
  # A tool that fails shows in the status document; it does not fail provisioning.
  ship_ctl tools run || log "some tools failed; see ship-ctl logs tools"
  local uid i
  uid=$(id -u "$AGENT")
  systemctl start "user@$uid.service"
  for i in $(seq 30); do
    [ -S "/run/user/$uid/bus" ] && break
    sleep 1
  done
  as_agent systemctl --user daemon-reload
  as_agent systemctl --user start herdr.service
  # The first status refresh records this boot's (empty) resume, then autostarts.
  log "herdr started (after ${i}s)"
}

# --- bake: the apt packages of the recipes marked bake ----------------------------
step_bake_recipes() {
  local id file pkgs=()
  [ -n "$BAKE_RECIPES" ] || return 0
  for id in ${BAKE_RECIPES//,/ }; do
    [[ $id =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "--recipes: bad recipe id '$id'"
    file=$BUNDLE/tools/$id.toml
    [ -f "$file" ] || die "--recipes: no recipe $id in this bundle"
    [ "$(cfg "$file" bake)" = true ] || die "--recipes: $id is not marked bake = true"
    mapfile -t -O "${#pkgs[@]}" pkgs < <(cfg "$file" apt)
  done
  [ "${#pkgs[@]}" -gt 0 ] || return 0
  if [ "$SANDBOX" = 1 ]; then log "skipped (--root): apt packages ${pkgs[*]}"; return 0; fi
  # As ship-ctl tools installs them (contracts/tools.md): no recommends.
  local missing
  mapfile -t missing < <(missing_debs "${pkgs[@]}")
  [ "${#missing[@]}" -gt 0 ] || return 0
  if [ "$APT_STALE" = 1 ] || [ "$APT_UPDATED" = 0 ]; then
    sys apt-get update -q
    APT_STALE=0
    APT_UPDATED=1
  fi
  changed "apt packages: ${missing[*]}"
  sys apt-get install -y -q --no-install-recommends "${missing[@]}"
}

parse_args() {
  while [ $# -gt 0 ]; do
    case $1 in
      --first-boot) MODE=first-boot ;;
      --converge) MODE=converge ;;
      --bake) MODE=bake ;;
      --recipes) [ $# -ge 2 ] || { usage >&2; exit 2; }; BAKE_RECIPES=$2; shift ;;
      --dry-run) DRY=1 ;;
      --root) [ $# -ge 2 ] || { usage >&2; exit 2; }; ROOT=$2; shift ;;
      -h | --help) usage; exit 0 ;;
      *) usage >&2; exit 2 ;;
    esac
    shift
  done
  [ -n "$MODE" ] || { usage >&2; exit 2; }
  if [ -n "$BAKE_RECIPES" ] && [ "$MODE" != bake ]; then
    die "--recipes goes with --bake only"
  fi
  if [ -n "$ROOT" ] && [ "$(realpath -m "$ROOT")" = / ]; then
    die "--root / would change this machine; leave --root out for a real run"
  fi
  ROOT=${ROOT%/}
  [ "$ROOT" = "" ] || [ -d "$ROOT" ] || die "--root $ROOT is not a folder"
  # SANDBOX: --root given; system commands, queries and downloads are skipped and
  # not counted. DRY: the real system is queried, and nothing is changed.
  SANDBOX=0
  [ -z "$ROOT" ] || SANDBOX=1
  APT_UPDATED=0
}

# --- main ----------------------------------------------------------------------------
main() {
  if [ "$SANDBOX" = 0 ]; then
    [ "$(id -u)" = 0 ] || die "run as root"
  fi
  if [ "$SANDBOX" = 0 ] && [ "$DRY" = 0 ] && [ "$MODE" != bake ]; then
    exec 9>/run/lock/ship-provision.lock
    flock -n 9 || die "another ship-provision is running"
    if [ "$MODE" = converge ]; then
      install -d -m 0750 /var/log/shipshape
      [ -e /var/log/shipshape/provision.log ] || install -m 0640 /dev/null /var/log/shipshape/provision.log
      exec > >(tee -a /var/log/shipshape/provision.log) 2>&1
    fi
  fi
  log "$MODE from $(basename "$BUNDLE")${ROOT:+ (root $ROOT)}$([ "$DRY" = 1 ] && echo ' (dry run)')"
  trap on_exit EXIT
  record running

  export DEBIAN_FRONTEND=noninteractive
  ensure_debs "${BASE_PACKAGES[@]}"
  start_guest_agent
  step_apt_repos
  step_core_packages
  step_herdr
  step_herdr_core
  step_uv
  if [ "$MODE" = bake ]; then
    step_bake_recipes
    [ "$SANDBOX" = 1 ] || [ "$DRY" = 1 ] || sys apt-get clean
    FINISHED=1
    log "bake done: $CHANGES change(s)"
    return 0
  fi
  step_shipshape_files
  step_ship_axi
  step_agent_home
  step_claude
  step_system_config
  step_units
  step_netwatch
  [ "$MODE" = first-boot ] && step_first_boot

  FINISHED=1
  record ok
  if [ "$DRY" = 1 ]; then
    log "dry run: $CHANGES change(s) would be made"
  else
    log "done: $CHANGES change(s)"
  fi
}

# Sourcing the script (tests) defines the functions without running anything.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  parse_args "$@"
  main
fi
