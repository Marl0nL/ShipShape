# --- Local config: personal, never committed (see docs/hygiene.md) -----------
# FleetLedger inventory and any local overrides. The repo ships only generic
# examples under contracts/examples/.
/ships.toml
*.local.toml
.env
.env.*
!.env.example

# Seeds contain a Ship's private host key.
seeds/
*.seed.iso

# --- Python / Node / tooling ---------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
node_modules/

# --- Old container stack: local data left in existing checkouts ---------------
# These paths held secrets and runtime state for the stack now in legacy/.
# Keep ignoring them so leftovers in an existing checkout are never committed.
/auth/
/instances/
/firstmate-data/
/control-plane/state/
/control-plane/spool/
/shipshape.toml
/squid.conf
/egress/allowed_domains.txt
/egress/*.bak
legacy/auth/*
!legacy/auth/README.md
