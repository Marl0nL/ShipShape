{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.shipshape.invalid/ship-ctl-result.schema.json",
  "title": "ship-ctl --json result (every command except a successful status)",
  "description": "Printed on stdout by `ship-ctl <command> --json` for apply, set, autostart, notify-signin, signin, converge, tools, toolkit, version, logs, ssh-trust, net, overlay, agent, inbox, wake and runtime, and by `ship-ctl status --json` when it cannot produce a status document. The exit code carries the same outcome (see contracts/ship-ctl.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "command", "ok", "changed", "messages", "error"],
  "properties": {
    "schema": { "const": "shipshape.ship-ctl-result/1" },
    "command": {
      "enum": [
        "status",
        "apply",
        "set",
        "autostart",
        "notify-signin",
        "signin",
        "converge",
        "tools",
        "toolkit",
        "version",
        "logs",
        "grow-root",
        "ssh-trust",
        "net",
        "overlay",
        "agent",
        "inbox",
        "wake",
        "runtime"
      ]
    },
    "ok": { "type": "boolean" },
    "changed": {
      "type": "array",
      "items": { "type": "string", "maxLength": 300 },
      "description": "What changed: file paths, agent names started, tool ids installed."
    },
    "messages": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 },
      "description": "Short human-readable notes, safe to show as-is."
    },
    "data": {
      "type": "object",
      "description": "Command-specific payload, documented per command in contracts/ship-ctl.md."
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "usage",
                "not-root",
                "invalid-ship-toml",
                "invalid-bundle",
                "bundle-checksum",
                "invalid-toolkit",
                "toolkit-rollback",
                "provision-failed",
                "tool-failed",
                "herdr-unavailable",
                "agent-busy",
                "agent-failed",
                "invalid-input",
                "overlay-failed",
                "overlay-not-joined",
                "runtime-missing",
                "switch-failed",
                "internal"
              ]
            },
            "message": { "type": "string", "maxLength": 1000 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "properties": { "error": { "type": "null" } } },
      "else": { "properties": { "error": { "type": "object" } } }
    }
  ]
}
